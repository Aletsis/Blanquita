# Copie este archivo como .env (junto a Blanquita.Web.dll en producción, o en la raíz del repositorio en desarrollo).
# .env está en .gitignore: nunca lo versione.

# Cadena de conexión a PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Database=BlanquitaDB;Username=postgres;Password=CAMBIAR

# Llave para cifrar credenciales guardadas en la BD (SMTP, API Keys).
# IMPORTANTE: si ya hay credenciales guardadas, al cambiar la llave deberá volver a capturarlas en Configuración.
# Encryption__Key=una-llave-larga-y-aleatoria

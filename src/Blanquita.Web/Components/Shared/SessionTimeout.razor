@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject AntiforgeryStateProvider Antiforgery
@using Blanquita.Web.Extensions
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable

@code {
    private DotNetObjectReference<SessionTimeout> _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            // Iniciar timeout de 5 minutos
            await JSRuntime.InvokeVoidAsync("sessionTimeout.initialize", _objRef, 5);
        }
    }

    [JSInvokable]
    public async Task OnSessionTimeout()
    {
        // Cerrar sesión con POST (el endpoint de logout ya no acepta GET)
        await JSRuntime.SubmitLogoutAsync(Antiforgery);
    }

    public async ValueTask DisposeAsync()
    {
        _objRef?.Dispose();
        try 
        {
            await JSRuntime.InvokeVoidAsync("sessionTimeout.cleanup");
        }
        catch 
        {
            // Ignore during rendering teardown
        }
    }
}

@code {
    private ConfiguracionDto _configuracion = new();
    private List<PrinterDto> _printers = new();
    private bool _guardando = false;
    private bool _loadingPrinters = false;
    private bool _enviandoPrueba = false;
    private bool _isInitialized = false;

    // Variables para gestión de cajas
    private IEnumerable<BranchDto> sucursales = Enumerable.Empty<BranchDto>();
    private MudTable<CashRegisterDto>? table;
    private string searchString = "";

    // Variables para WhatsApp
    private string whatsappStatus = "DISCONNECTED";
    private string? whatsappQrCode = null;
    private string testPhoneNumber = "";
    private string testMessage = "Mensaje de prueba desde Blanquita App";
    private bool _enviandoMensaje = false;

    private Color GetWhatsAppStatusColor()
    {
        return whatsappStatus switch
        {
            "CONNECTED" => Color.Success,
            "CONNECTING" => Color.Warning,
            _ => Color.Error
        };
    }

    private async Task CheckWhatsAppStatus()
    {
        try
        {
            var baseUrl = string.IsNullOrWhiteSpace(_configuracion.WhatsAppServiceUrl) ? "http://localhost:3001" : _configuracion.WhatsAppServiceUrl;
            using var client = new System.Net.Http.HttpClient();
            client.DefaultRequestHeaders.ExpectContinue = false;
            var response = await client.GetFromJsonAsync<WhatsAppStatusResponse>($"{baseUrl}/status");
            if (response != null)
            {
                whatsappStatus = response.Status;
                whatsappQrCode = response.Qr;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al verificar el estado de WhatsApp");
            Snackbar.Add("No se pudo conectar al microservicio de WhatsApp", Severity.Error);
            whatsappStatus = "DISCONNECTED";
            whatsappQrCode = null;
        }
    }

    private async Task LogoutWhatsApp()
    {
        try
        {
            var baseUrl = string.IsNullOrWhiteSpace(_configuracion.WhatsAppServiceUrl) ? "http://localhost:3001" : _configuracion.WhatsAppServiceUrl;
            using var client = new System.Net.Http.HttpClient();
            client.DefaultRequestHeaders.ExpectContinue = false;
            var response = await client.PostAsync($"{baseUrl}/logout", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Sesión de WhatsApp cerrada correctamente", Severity.Info);
                await CheckWhatsAppStatus();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cerrar sesión de WhatsApp");
            Snackbar.Add("Error al cerrar sesión", Severity.Error);
        }
    }

    private async Task SendTestWhatsAppMessage()
    {
        if (string.IsNullOrWhiteSpace(testPhoneNumber) || testPhoneNumber.Length != 10)
        {
            Snackbar.Add("Por favor ingrese un número de teléfono de 10 dígitos válido.", Severity.Warning);
            return;
        }

        _enviandoMensaje = true;
        try
        {
            var baseUrl = string.IsNullOrWhiteSpace(_configuracion.WhatsAppServiceUrl) ? "http://localhost:3001" : _configuracion.WhatsAppServiceUrl;
            using var client = new System.Net.Http.HttpClient();
            client.DefaultRequestHeaders.ExpectContinue = false;
            var payload = new System.Collections.Generic.Dictionary<string, string>
            {
                { "number", testPhoneNumber },
                { "message", testMessage }
            };
            var response = await client.PostAsJsonAsync($"{baseUrl}/send", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Mensaje de prueba enviado exitosamente", Severity.Success);
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Fallo al enviar WhatsApp. Status: {StatusCode}, Content: {Content}", response.StatusCode, content);
                if (content.TrimStart().StartsWith("<"))
                {
                    Snackbar.Add($"Fallo al enviar mensaje: {response.StatusCode} ({response.ReasonPhrase})", Severity.Error);
                }
                else
                {
                    Snackbar.Add($"Fallo al enviar mensaje: {content}", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al enviar mensaje de WhatsApp");
            Snackbar.Add("Error al enviar el mensaje de prueba", Severity.Error);
        }
        finally
        {
            _enviandoMensaje = false;
        }
    }

    private class WhatsAppStatusResponse
    {
        public string Status { get; set; } = "DISCONNECTED";
        public string? Qr { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _configuracion = await ConfigService.ObtenerConfiguracionAsync();
            await RecargarImpresoras();
            sucursales = await BranchService.GetAllAsync();
            
            // Verificar estado de WhatsApp si hay una URL configurada
            if (!string.IsNullOrWhiteSpace(_configuracion.WhatsAppServiceUrl))
            {
                await CheckWhatsAppStatus();
            }

            // Marcar como inicializado para permitir la carga de la tabla
            _isInitialized = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar la configuración inicial");
            Snackbar.Add("Error al cargar la configuración", Severity.Error);

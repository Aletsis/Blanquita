@page "/configuracion"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using Blanquita.Application.DTOs
@using Blanquita.Application.Interfaces
@using Blanquita.Application.Helpers
@using Blanquita.Domain.Enums
@using Blanquita.Web.Models
@using Blanquita.Web.Components.Layout
@using Microsoft.AspNetCore.Components.Forms
@inject IConfiguracionService ConfigService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILogger<Configuracion> Logger
@inject IDialogService DialogService
@inject IPrinterService PrinterService
@inject ICashRegisterService CashRegisterService
@inject IBranchService BranchService
@inject IEmailService EmailService

<PageTitle>Configuración - Sistema de Reportes</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 animated fadeIn">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="background: linear-gradient(45deg, #1e88e5, #5e35b1); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" Size="Size.Large" Color="Color.Primary" />
            Configuración del Sistema
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudTooltip Text="Verificar conexión a base de datos">
                <MudIconButton Icon="@Icons.Material.Filled.BugReport" Color="Color.Info" OnClick="IrADiagnostico" Variant="Variant.Outlined" />
            </MudTooltip>
             <MudTooltip Text="Restablecer valores">
                <MudIconButton Icon="@Icons.Material.Filled.Restore" OnClick="LimpiarFormulario" Variant="Variant.Outlined" />
            </MudTooltip>
            <MudButton Variant="Variant.Filled" 
                      StartIcon="@Icons.Material.Filled.Save" 
                      Color="Color.Primary" 
                      OnClick="GuardarConfiguracion" 
                      Disabled="@_guardando"
                      Class="ml-2">
                @if (_guardando) 
                { 
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> 
                    <text>Guardando...</text> 
                } 
                else 
                { 
                    <text>Guardar Cambios</text> 
                }
            </MudButton>
        </MudStack>
    </MudStack>

    <MudTabs Elevation="4" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Class="mt-6 rounded-lg animate-slide-up" Color="Color.Primary">
        
        @* PESTAÑA: BASE DE DATOS *@
        <MudTabPanel Text="Base de Datos" Icon="@Icons.Material.Filled.Storage">
            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-2" />
                Rutas de Archivos FoxPro (DBF)
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">POS10041.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Pos10041Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Pos10041)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Pos10041Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Pos10041Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Pos10041Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">POS10042.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Pos10042Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Pos10042)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Pos10042Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Pos10042Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Pos10042Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">MGW10008.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Mgw10008Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Mgw10008)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Mgw10008Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Mgw10008Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Mgw10008Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">MGW10005.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Mgw10005Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Mgw10005)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Mgw10005Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Mgw10005Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Mgw10005Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">MGW10045.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Mgw10045Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Mgw10045)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Mgw10045Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Mgw10045Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Mgw10045Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">MGW10002.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Mgw10002Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Mgw10002)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Mgw10002Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Mgw10002Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Mgw10002Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">MGW10011.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Mgw10011Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Mgw10011)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Mgw10011Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Mgw10011Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Mgw10011Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">POS10008.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Pos10008Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Pos10008)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Pos10008Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Pos10008Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Pos10008Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">POS10010.DBF</MudText>
                        <MudTextField @bind-Value="_configuracion.Pos10010Path" Label="Ruta" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="() => AbrirDialogoArchivo(TipoArchivoDbf.Pos10010)" Margin="Margin.Dense" />
                        @if (!string.IsNullOrEmpty(_configuracion.Pos10010Path)) { <MudChip T="string" Size="Size.Small" Color="@(ValidarRuta(_configuracion.Pos10010Path) ? Color.Success : Color.Error)">@(ValidarRuta(_configuracion.Pos10010Path) ? "Encontrado" : "No encontrado")</MudChip> }
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* PESTAÑA: FACTURACIÓN *@
        <MudTabPanel Text="Facturación" Icon="@Icons.Material.Filled.ReceiptLong">
            <MudGrid>
                <MudItem xs="12" md="7">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">Almacenamiento y PDFs</MudText>
                    <MudCard Outlined="true" Class="pa-4">
                        <MudTextField @bind-Value="_configuracion.FacturasPath" Label="Carpeta de Facturas" Variant="Variant.Outlined" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="AbrirDialogoCarpetaFacturas" Margin="Margin.Dense" />
                        <MudChip T="string" Size="Size.Small" Color="@(ValidarDirectorio(_configuracion.FacturasPath) ? Color.Success : Color.Error)" Class="mt-2">@(ValidarDirectorio(_configuracion.FacturasPath) ? "Válido" : "No Válido")</MudChip>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">Programación Automática</MudText>
                    <MudCard Outlined="true" Class="pa-4">
                        <MudTimePicker Label="Hora de envío" @bind-Time="_configuracion.InvoiceJobExecutionTime" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="true" />
                        <MudTextField @bind-Value="_configuracion.AlertEmails" Label="Emails de Alerta" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" Placeholder="admin@ejemplo.com" />
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* PESTAÑA: CORREO (SMTP) *@
        <MudTabPanel Text="Correo" Icon="@Icons.Material.Filled.Email">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_configuracion.SmtpServer" Label="Servidor SMTP" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_configuracion.SmtpPort" Label="Puerto" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_configuracion.SmtpUser" Label="Usuario" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_configuracion.SmtpPassword" Label="Contraseña" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" Class="d-flex align-center justify-space-between mt-4">
                    <MudSwitch @bind-Value="_configuracion.SmtpEnableSsl" Label="Habilitar SSL" Color="Color.Primary" />
                    <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Send" OnClick="EnviarCorreoPrueba" Disabled="@_enviandoPrueba">Enviar Prueba</MudButton>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* PESTAÑA: EQUIPOS *@
        <MudTabPanel Text="Equipos" Icon="@Icons.Material.Filled.Dns">
            <MudStack Spacing="6">
                    <MudTable Items="@_printers" Hover="true" Dense="true" Elevation="0" Outlined="true">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6" Color="Color.Primary">Impresoras Zebra</MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => AbrirDialogoImpresora()" Size="Size.Small">Nueva</MudButton>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Nombre</MudTh>
                            <MudTh>IP</MudTh>
                            <MudTh Style="text-align: center;">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@context.IpAddress</MudTd>
                            <MudTd Style="text-align: center;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => AbrirDialogoImpresora(context)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => EliminarImpresora(context)" />
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>

                @if (_isInitialized)
                {
                    <MudTable ServerData="ServerReload" Dense="true" Hover="true" @ref="table" Elevation="0" Outlined="true">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6" Color="Color.Primary">Cajas Registradoras</MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => AbrirDialogoCaja()" Size="Size.Small">Nueva</MudButton>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Nombre</MudTh>
                            <MudTh>Tipo de Terminal</MudTh>
                            <MudTh>IP Impresora</MudTh>
                            <MudTh Style="text-align: center;">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>
                                @if (context.Tipo == TipoTerminal.Pedidos)
                                {
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Assignment" Variant="Variant.Text">Pedidos</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Storefront" Variant="Variant.Text">Piso de ventas</MudChip>
                                }
                            </MudTd>
                            <MudTd>@context.PrinterIp</MudTd>
                            <MudTd Style="text-align: center;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AbrirDialogoCaja(context))" />
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                }
            </MudStack>
        </MudTabPanel>

        @* PESTAÑA: SUCURSALES *@
        <MudTabPanel Text="Sucursales" Icon="@Icons.Material.Filled.Store">
            <MudTable Items="@sucursales" Hover="true" Elevation="0" Outlined="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Color="Color.Primary">Sucursales</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => AbrirDialogoSucursal()">Nueva</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Código</MudTh>
                    <MudTh>Dirección</MudTh>
                    <MudTh Style="text-align: center;">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@context.Code</MudTd>
                    <MudTd>@context.Direccion</MudTd>
                    <MudTd Style="text-align: center;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => AbrirDialogoSucursal(context)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        @* PESTAÑA: API COMERCIAL *@
        <MudTabPanel Text="API Comercial" Icon="@Icons.Material.Filled.Cloud">
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Cloud" Class="mr-2" />
                Configuración de API Comercial
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudCard Outlined="true" Class="pa-4">
                        <MudTextField @bind-Value="_configuracion.CommercialApiUrl" 
                                      Label="Dirección (URL) de la API" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Placeholder="https://api.comercial.example.com" 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Link" />
                        <MudText Typo="Typo.caption" Class="mt-2 d-block text-muted">
                            Esta dirección se utilizará para sincronizar y conectar el sistema con la API Comercial.
                        </MudText>

                        <MudTextField @bind-Value="_configuracion.CommercialApiKey" 
                                      Label="API Key" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense"
                                      Class="mt-4"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.VpnKey" />
                        <MudText Typo="Typo.caption" Class="mt-2 d-block text-muted">
                            Clave de autenticación requerida por la API Comercial para todas las solicitudes.
                        </MudText>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* PESTAÑA: WHATSAPP *@
        <MudTabPanel Text="WhatsApp" Icon="@Icons.Custom.Brands.WhatsApp">
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">
                <MudIcon Icon="@Icons.Custom.Brands.WhatsApp" Class="mr-2" />
                Configuración de WhatsApp (Baileys Service)
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudCard Outlined="true" Class="pa-4 mb-4">
                        <MudTextField @bind-Value="_configuracion.WhatsAppServiceUrl" 
                                      Label="URL del Microservicio de WhatsApp" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Placeholder="http://localhost:3001" 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Link" />
                        <MudText Typo="Typo.caption" Class="mt-2 d-block text-muted">
                            URL local o externa donde se ejecuta el microservicio Node.js con Baileys.
                        </MudText>
                        
                        <div class="d-flex align-center gap-4 mt-6">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckWhatsAppStatus" StartIcon="@Icons.Material.Filled.Refresh">Verificar Estado</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="LogoutWhatsApp" StartIcon="@Icons.Material.Filled.Logout">Cerrar Sesión (Desconectar)</MudButton>
                        </div>
                    </MudCard>

                    <MudCard Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Enviar Mensaje de Prueba</MudText>
                        <MudTextField @bind-Value="testPhoneNumber" Label="Número de teléfono (10 dígitos)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Placeholder="3312345678" />
                        <MudTextField @bind-Value="testMessage" Label="Mensaje de prueba" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Lines="3" />
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SendTestWhatsAppMessage" Disabled="_enviandoMensaje" StartIcon="@Icons.Material.Filled.Send">
                            @if (_enviandoMensaje) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/> } Enviar Mensaje
                        </MudButton>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCard Outlined="true" Class="pa-4 d-flex flex-column align-center justify-center" Style="min-height: 380px;">
                        <MudText Typo="Typo.h6" Class="mb-4">Estado de Conexión: 
                            <MudChip T="string" Color="GetWhatsAppStatusColor()">@whatsappStatus</MudChip>
                        </MudText>
                        @if (!string.IsNullOrEmpty(whatsappQrCode))
                        {
                            <MudText Typo="Typo.body2" Class="mb-4 text-center">Escanea este código QR desde tu celular para conectar tu WhatsApp.</MudText>
                            <img src="@whatsappQrCode" alt="Código QR de WhatsApp" style="max-width: 250px; border: 1px solid #ccc; padding: 10px; border-radius: 8px; background: white;" />
                        }
                        else if (whatsappStatus == "CONNECTED")
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Style="font-size: 5rem;" />
                            <MudText Typo="Typo.body1" Class="mt-3 font-weight-bold text-success">¡WhatsApp sincronizado y listo!</MudText>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Color="Color.Default" Size="Size.Large" Style="font-size: 5rem;" />
                            <MudText Typo="Typo.body2" Class="mt-3 text-muted text-center">Esperando código QR o inicialización del servicio...</MudText>
                        }
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

    </MudTabs>
</MudContainer>

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }
    .animate-slide-up {
        animation: slideUp 0.5s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes slideUp {

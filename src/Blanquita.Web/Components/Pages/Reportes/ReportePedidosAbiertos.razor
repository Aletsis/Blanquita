@page "/reportes/PedidosAbiertos"
@page "/reportes/pedidos-abiertos"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Security,Supervisor")]
@using Blanquita.Application.DTOs
@using Blanquita.Application.Queries.FoxPro.GetOpenPedidosReport
@using MediatR
@using Blanquita.Application.Interfaces
@inject IMediator Mediator
@inject IBranchService BranchService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ILogger<ReportePedidosAbiertos> Logger
@inject IExportService ExportService

<PageTitle>Reporte de Pedidos Abiertos</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 animate-fade-in">
    <MudText Typo="Typo.h4" Class="mb-6 font-weight-bold" Style="background: linear-gradient(45deg, #1976d2, #4caf50); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" Class="mr-2" Size="Size.Large" Color="Color.Primary" />
        Reporte de Pedidos Abiertos (POS)
    </MudText>

    <MudGrid>
        <!-- Formulario de parámetros -->
        <MudItem xs="12" md="3">
            <MudCard Elevation="4" Class="rounded-xl">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-2" />
                        Filtros de Consulta
                    </MudText>

                    <MudSelect T="BranchDto" @bind-Value="sucursalSeleccionada"
                               Label="Sucursal"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-3"
                               ToStringFunc="@(b => b?.Name)"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@((BranchDto?)null)">Todas las sucursales</MudSelectItem>
                        @if (sucursales != null)
                        {
                            @foreach (var suc in sucursales)
                            {
                                <MudSelectItem Value="@suc">@suc.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="_comanda"
                                  Label="Comanda"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.ConfirmationNumber"
                                  Placeholder="Ej: 12345"
                                  Clearable="true"
                                  Class="mb-3" />

                    <MudTextField @bind-Value="_ruta"
                                  Label="Ruta"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.AltRoute"
                                  Placeholder="Ej: R1"
                                  Clearable="true"
                                  Class="mb-3" />

                    <MudDatePicker @bind-Date="_fechaInicio"
                                   Label="Fecha Inicial"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   MaxDate="DateTime.Today"
                                   Class="mb-3" />

                    <MudDatePicker @bind-Date="_fechaFin"
                                   Label="Fecha Final"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   MaxDate="DateTime.Today"
                                   Class="mb-3" />

                    <MudDivider Class="my-3" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="GenerarReporte"
                               Disabled="@generando"
                               Size="Size.Large"
                               Class="py-2 rounded-lg shadow-sm">
                        @if (generando)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <text>Consultando...</text>
                        }
                        else
                        {
                            <text>Consultar</text>
                        }
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Resultados -->
        <MudItem xs="12" md="9">
            @if (generando)
            {
                <MudCard Elevation="4" Class="rounded-xl pa-8 text-center animate-fade-in">
                    <MudCardContent>
                        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="mt-4">Consultando pedidos abiertos en punto de venta...</MudText>
                    </MudCardContent>
                </MudCard>
            }
            else if (reporteGenerado && datosReporte != null)
            {
                <div class="animate-slide-up">
                    <!-- Tarjetas de Resumen Ejecutivo -->
                    <MudGrid Class="mb-4" Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="3" Class="pa-3 rounded-xl border-light bg-light text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Pedidos Abiertos</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">@datosReporte.Count</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="3" Class="pa-3 rounded-xl border-light bg-light text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Monto Total Pendiente</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Success">@TotalPendiente.ToString("C2", _culture)</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="3" Class="pa-3 rounded-xl border-light bg-light text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Antigüedad Promedio</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Info">@PromedioDias.ToString("0.0") días</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="3" Class="pa-3 rounded-xl border-light bg-light text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Críticos (> 7 Días)</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">@CountCriticos (@TotalCriticos.ToString("C2", _culture))</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <MudCard Elevation="4" Class="rounded-xl">
                        <MudCardContent Class="pa-4">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                 <MudText Typo="Typo.h6" Color="Color.Primary">
                                    <MudIcon Icon="@Icons.Material.Filled.TableChart" Class="mr-2" />
                                    Listado de Pedidos Abiertos
                                </MudText>
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Download"
                                               Color="Color.Success"
                                               OnClick="ExportarExcel"
                                               Size="Size.Small">
                                        Excel
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                               Color="Color.Error"
                                               OnClick="ExportarPDF"
                                               Size="Size.Small">
                                        PDF
                                    </MudButton>
                                </MudStack>
                            </MudStack>

                            @if (datosReporte.Any())
                            {
                                <MudTable Items="@datosReporte" Dense="true" Hover="true" Striped="true" Elevation="0" Bordered="true" Breakpoint="Breakpoint.None">
                                    <HeaderContent>
                                        <MudTh>Folio</MudTh>
                                        <MudTh>Fecha</MudTh>
                                        <MudTh>Serie</MudTh>
                                        <MudTh>Cliente</MudTh>
                                        <MudTh Style="text-align: center;">Antigüedad</MudTh>
                                        <MudTh Style="text-align: center;">Partidas</MudTh>
                                        <MudTh Style="text-align: right;">Total</MudTh>
                                        <MudTh Style="text-align: center;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Folio">
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Folio</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd DataLabel="Sucursal">@context.Sucursal</MudTd>
                                        <MudTd DataLabel="Cliente">@context.Cliente</MudTd>
                                        <MudTd DataLabel="Antigüedad" Style="text-align: center;">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetAntiguedadColor(context.DiasAbierto)">
                                                @context.DiasAbierto d
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Partidas" Style="text-align: center;">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                @context.PartidasCount art.
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Total" Style="text-align: right; font-weight:bold; color: #2e7d32;">@context.Total.ToString("C2", _culture)</MudTd>
                                        <MudTd DataLabel="Acciones" Style="text-align: center;">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => VerDetallePedido(context))" />
                                        </MudTd>
                                    </RowTemplate>
                                    <FooterContent>
                                        <MudTh Style="font-weight: bold; text-align: right;" colspan="8">TOTAL PENDIENTE:</MudTh>
                                        <MudTh Style="font-weight: bold; text-align: right; color: #2e7d32;">@TotalPendiente.ToString("C2", _culture)</MudTh>
                                        <MudTh></MudTh>
                                    </FooterContent>
                                </MudTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Class="mt-2">No se encontraron pedidos abiertos para los filtros seleccionados.</MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </div>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .animate-fade-in { animation: fadeIn 0.5s ease-out; }
    .animate-slide-up { animation: slideUp 0.5s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .rounded-xl { border-radius: 16px !important; }
    .border-light { border: 1px solid rgba(0,0,0,0.08) !important; }
    .bg-light { background-color: #fafafa; }
    .font-weight-bold { font-weight: 700; }
</style>

@code {
    private BranchDto? sucursalSeleccionada;
    private IEnumerable<BranchDto> sucursales = new List<BranchDto>();
    private DateTime? _fechaInicio;
    private DateTime? _fechaFin;
    private string? _comanda;
    private string? _ruta;
    private bool generando = false;
    private bool reporteGenerado = false;
    private List<OpenPedidoReportItemDto>? datosReporte;
    private System.Globalization.CultureInfo _culture = System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    private decimal TotalPendiente => datosReporte?.Sum(x => x.Total) ?? 0;
    private double PromedioDias => datosReporte != null && datosReporte.Any() ? datosReporte.Average(x => x.DiasAbierto) : 0;
    private int CountCriticos => datosReporte?.Count(x => x.DiasAbierto > 7) ?? 0;
    private decimal TotalCriticos => datosReporte?.Where(x => x.DiasAbierto > 7).Sum(x => x.Total) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sucursales = await BranchService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar sucursales");
            Snackbar.Add("Error al cargar sucursales", Severity.Error);
        }
    }

    private Color GetAntiguedadColor(int dias)
    {
        if (dias <= 1) return Color.Success;
        if (dias <= 7) return Color.Warning;
        return Color.Error;
    }

    private async Task GenerarReporte()
    {
        generando = true;
        reporteGenerado = false;
        datosReporte = null;

        try
        {
            List<string>? series = null;
            if (sucursalSeleccionada != null)
            {
                var combinedSeries = $"{sucursalSeleccionada.SeriesCliente},{sucursalSeleccionada.SeriesGlobal}".Trim();
                series = combinedSeries.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
            }

            var query = new GetOpenPedidosReportQuery(
                StartDate: _fechaInicio,
                EndDate: _fechaFin,
                Series: series,
                Comanda: _comanda,
                Ruta: _ruta,
                SucursalNombre: sucursalSeleccionada?.Name
            );
            
            var result = await Mediator.Send(query);
            datosReporte = result.ToList();
            reporteGenerado = true;
            
            if (datosReporte.Any())
                Snackbar.Add($"Se encontraron {datosReporte.Count} pedidos abiertos", Severity.Success);
            else
                Snackbar.Add("No se encontraron pedidos abiertos", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al consultar: {ex.Message}", Severity.Error);
            Logger.LogError(ex, "Error al generar reporte de pedidos abiertos");
        }
        finally
        {
            generando = false;
        }
    }

    private async Task VerDetallePedido(OpenPedidoReportItemDto pedido)
    {
        var parameters = new DialogParameters<Dialogs.DialogoDetallePedido>
        {
            { x => x.Pedido, new PedidoDto 
                { 
                    IdDocumento = pedido.IdDocumento,
                    Folio = pedido.Folio,
                    Fecha = pedido.Fecha,
                    Comanda = pedido.Comanda,
                    Ruta = pedido.Ruta,
                    BranchName = pedido.Sucursal,
                    Total = pedido.Total,
                    NetAmount = pedido.Neto,
                    TaxAmount = pedido.Impuesto,
                    Status = "Abierto"
                } 
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<Dialogs.DialogoDetallePedido>("Detalle de Pedido", parameters, options);
    }

    private async Task ExportarExcel()
    {
        if (datosReporte == null || !datosReporte.Any()) return;

        try
        {
            var contenido = await ExportService.ExportToExcelAsync(datosReporte, "PedidosAbiertos");
            var nombreArchivo = $"PedidosAbiertos_{sucursalSeleccionada?.Name ?? "General"}_{DateTime.Today:yyyyMMdd}.xlsx";
            await DescargarArchivo(contenido, nombreArchivo, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add("Reporte exportado exitosamente a Excel", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar a Excel: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportarPDF()
    {
        if (datosReporte == null || !datosReporte.Any()) return;

        try
        {
            var contenido = await ExportService.ExportToPdfAsync(datosReporte, $"Reporte de Pedidos Abiertos - {sucursalSeleccionada?.Name ?? "General"}");
            var nombreArchivo = $"PedidosAbiertos_{sucursalSeleccionada?.Name ?? "General"}_{DateTime.Today:yyyyMMdd}.pdf";
            await DescargarArchivo(contenido, nombreArchivo, "application/pdf");
            Snackbar.Add("Reporte exportado exitosamente a PDF", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar a PDF: {ex.Message}", Severity.Error);
        }
    }

    private async Task DescargarArchivo(byte[] contenido, string nombreArchivo, string contentType)
    {
        var base64 = Convert.ToBase64String(contenido);
        await JS.InvokeVoidAsync("fileDownloadHelper.downloadFile", nombreArchivo, contentType, base64);
    }
}

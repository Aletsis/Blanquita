@page "/reportes/cancelaciones"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Security,Supervisor")]
@using Blanquita.Application.DTOs
@using Blanquita.Application.Queries.FoxPro.GetCancellationReport
@using MediatR
@using Blanquita.Application.Interfaces
@inject IMediator Mediator
@inject IBranchService BranchService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<ReporteCancelaciones> Logger
@inject IExportService ExportService

<PageTitle>Reporte de Cancelaciones</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 animate-fade-in">
    <MudText Typo="Typo.h4" Class="mb-6 font-weight-bold" Style="background: linear-gradient(45deg, #d32f2f, #ff9800); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="mr-2" Size="Size.Large" Color="Color.Error" />
        Reporte de Cancelaciones (POS)
    </MudText>

    <MudGrid>
        <!-- Formulario de parámetros -->
        <MudItem xs="12" md="3">
            <MudCard Elevation="4" Class="rounded-xl">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-2" />
                        Filtros de Consulta
                    </MudText>

                    <MudSelect T="BranchDto" @bind-Value="sucursalSeleccionada"
                               Label="Sucursal"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-3"
                               ToStringFunc="@(b => b?.Name)"
                               AnchorOrigin="Origin.BottomCenter">
                        @if (sucursales != null)
                        {
                            @foreach (var suc in sucursales)
                            {
                                <MudSelectItem Value="@suc">@suc.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="string" @bind-Value="_tipoSeleccionado"
                               Label="Tipo de Cancelación"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-3"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("Todas")">Todas</MudSelectItem>
                        <MudSelectItem Value="@("Completa")">Completas</MudSelectItem>
                        <MudSelectItem Value="@("Parcial")">Parciales</MudSelectItem>
                    </MudSelect>

                    <MudDatePicker @bind-Date="_fechaInicio"
                                   Label="Fecha Inicial"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   MaxDate="DateTime.Today"
                                   Class="mb-3" />

                    <MudDatePicker @bind-Date="_fechaFin"
                                   Label="Fecha Final"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   MaxDate="DateTime.Today"
                                   Class="mb-3" />

                    <MudDivider Class="my-3" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="GenerarReporte"
                               Disabled="@(generando || _fechaInicio == null || _fechaFin == null)"
                               Size="Size.Large"
                               Class="py-2 rounded-lg shadow-sm">
                        @if (generando)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <text>Consultando...</text>
                        }
                        else
                        {
                            <text>Consultar</text>
                        }
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Resultados -->
        <MudItem xs="12" md="9">
            @if (generando)
            {
                <MudCard Elevation="4" Class="rounded-xl pa-8 text-center animate-fade-in">
                    <MudCardContent>
                        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Error" />
                        <MudText Typo="Typo.h6" Class="mt-4">Consultando cancelaciones en punto de venta...</MudText>
                    </MudCardContent>
                </MudCard>
            }
            else if (reporteGenerado && datosReporte != null)
            {
                <div class="animate-slide-up">
                    <!-- Tarjetas de Resumen Ejecutivo -->
                    <MudGrid Class="mb-4" Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="3" Class="pa-3 rounded-xl border-light bg-light text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Total Cancelaciones</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">@datosReporte.Count</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="3" Class="pa-3 rounded-xl border-light bg-light text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Monto Total Cancelado</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">@TotalCancelado.ToString("C2", _culture)</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="3" Class="pa-3 rounded-xl border-light bg-light text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Cancelaciones Completas</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Dark">@CountCompletas (@TotalCompletas.ToString("C2", _culture))</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="3" Class="pa-3 rounded-xl border-light bg-light text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Cancelaciones Parciales</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Warning">@CountParciales (@TotalParciales.ToString("C2", _culture))</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <MudCard Elevation="4" Class="rounded-xl">
                        <MudCardContent Class="pa-4">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                 <MudText Typo="Typo.h6" Color="Color.Primary">
                                    <MudIcon Icon="@Icons.Material.Filled.TableChart" Class="mr-2" />
                                    Detalle de Cancelaciones
                                </MudText>
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Download"
                                               Color="Color.Success"
                                               OnClick="ExportarExcel"
                                               Size="Size.Small">
                                        Excel
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                               Color="Color.Error"
                                               OnClick="ExportarPDF"
                                               Size="Size.Small">
                                        PDF
                                    </MudButton>
                                </MudStack>
                            </MudStack>

                            @if (datosReporte.Any())
                            {
                                <MudTable Items="@datosReporte" Dense="true" Hover="true" Striped="true" Elevation="0" Bordered="true" Breakpoint="Breakpoint.None">
                                    <HeaderContent>
                                        <MudTh>Fecha</MudTh>
                                        <MudTh>Serie</MudTh>
                                        <MudTh>Folio</MudTh>
                                        <MudTh>Tipo</MudTh>
                                        <MudTh>Documento</MudTh>
                                        <MudTh Style="text-align: center;">Partidas Canceladas</MudTh>
                                        <MudTh Style="text-align: right;">Neto</MudTh>
                                        <MudTh Style="text-align: right;">Impuesto</MudTh>
                                        <MudTh Style="text-align: right;">Total Cancelado</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd DataLabel="Serie">@context.Serie</MudTd>
                                        <MudTd DataLabel="Folio">@context.Folio</MudTd>
                                        <MudTd DataLabel="Tipo">
                                            <MudChip T="string" Color="@(context.TipoCancelacion == "Completa" ? Color.Error : Color.Warning)" Size="Size.Small" Variant="Variant.Filled">
                                                @context.TipoCancelacion
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Documento">@context.TipoDocumento</MudTd>
                                        <MudTd DataLabel="Partidas Canceladas" Style="text-align: center;">
                                            @if (context.Detalles.Any())
                                            {
                                                <MudTooltip Text="@string.Join(", ", context.Detalles.Select(d => $"{d.Units:0.##}x {d.ProductName} ({d.Total.ToString("C2", _culture)})"))">
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">
                                                        @context.Detalles.Count art.
                                                    </MudChip>
                                                </MudTooltip>
                                            }
                                            else
                                            {
                                                <text>Doc. Completo</text>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Neto" Style="text-align: right;">@context.Neto.ToString("C2", _culture)</MudTd>
                                        <MudTd DataLabel="Impuesto" Style="text-align: right;">@context.Impuesto.ToString("C2", _culture)</MudTd>
                                        <MudTd DataLabel="Total Cancelado" Style="text-align: right; font-weight:bold; color: #d32f2f;">@context.Total.ToString("C2", _culture)</MudTd>
                                    </RowTemplate>
                                    <FooterContent>
                                        <MudTh Style="font-weight: bold; text-align: right;" colspan="6">TOTALES:</MudTh>
                                        <MudTh Style="font-weight: bold; text-align: right;">@datosReporte.Sum(x => x.Neto).ToString("C2", _culture)</MudTh>
                                        <MudTh Style="font-weight: bold; text-align: right;">@datosReporte.Sum(x => x.Impuesto).ToString("C2", _culture)</MudTh>
                                        <MudTh Style="font-weight: bold; text-align: right; color: #d32f2f;">@TotalCancelado.ToString("C2", _culture)</MudTh>
                                    </FooterContent>
                                </MudTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Class="mt-2">No se encontraron cancelaciones para los filtros seleccionados.</MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </div>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .animate-fade-in { animation: fadeIn 0.5s ease-out; }
    .animate-slide-up { animation: slideUp 0.5s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .rounded-xl { border-radius: 16px !important; }
    .border-light { border: 1px solid rgba(0,0,0,0.08) !important; }
    .bg-light { background-color: #fafafa; }
    .font-weight-bold { font-weight: 700; }
</style>

@code {
    private BranchDto? sucursalSeleccionada;
    private IEnumerable<BranchDto> sucursales = new List<BranchDto>();
    private DateTime? _fechaInicio = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _fechaFin = DateTime.Today;
    private string _tipoSeleccionado = "Todas";
    private bool generando = false;
    private bool reporteGenerado = false;
    private List<CancellationReportItemDto>? datosReporte;
    private System.Globalization.CultureInfo _culture = System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    private decimal TotalCancelado => datosReporte?.Sum(x => x.Total) ?? 0;
    private int CountCompletas => datosReporte?.Count(x => x.TipoCancelacion == "Completa") ?? 0;
    private decimal TotalCompletas => datosReporte?.Where(x => x.TipoCancelacion == "Completa").Sum(x => x.Total) ?? 0;
    private int CountParciales => datosReporte?.Count(x => x.TipoCancelacion == "Parcial") ?? 0;
    private decimal TotalParciales => datosReporte?.Where(x => x.TipoCancelacion == "Parcial").Sum(x => x.Total) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sucursales = await BranchService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar sucursales");
            Snackbar.Add("Error al cargar sucursales", Severity.Error);
        }
    }

    private async Task GenerarReporte()
    {
        if (_fechaInicio == null || _fechaFin == null)
            return;

        generando = true;
        reporteGenerado = false;
        datosReporte = null;

        try
        {
            var query = new GetCancellationReportQuery(
                StartDate: _fechaInicio.Value,
                EndDate: _fechaFin.Value,
                Serie: sucursalSeleccionada?.SeriesCliente,
                Tipo: _tipoSeleccionado
            );
            
            var result = await Mediator.Send(query);
            datosReporte = result.ToList();
            reporteGenerado = true;
            
            if (datosReporte.Any())
                Snackbar.Add($"Se encontraron {datosReporte.Count} cancelaciones", Severity.Success);
            else
                Snackbar.Add("No se encontraron registros para los filtros seleccionados", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al consultar: {ex.Message}", Severity.Error);
            Logger.LogError(ex, "Error al generar reporte de cancelaciones");
        }
        finally
        {
            generando = false;
        }
    }

    private async Task ExportarExcel()
    {
        if (datosReporte == null || !datosReporte.Any()) return;

        try
        {
            var contenido = await ExportService.ExportToExcelAsync(datosReporte, "Cancelaciones");
            var nombreArchivo = $"Cancelaciones_{sucursalSeleccionada?.Name ?? "General"}_{_fechaInicio:yyyyMMdd}_{_fechaFin:yyyyMMdd}.xlsx";
            await DescargarArchivo(contenido, nombreArchivo, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add("Reporte exportado exitosamente a Excel", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar a Excel: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportarPDF()
    {
        if (datosReporte == null || !datosReporte.Any()) return;

        try
        {
            var contenido = await ExportService.ExportToPdfAsync(datosReporte, $"Reporte de Cancelaciones POS - {sucursalSeleccionada?.Name ?? "General"}");
            var nombreArchivo = $"Cancelaciones_{sucursalSeleccionada?.Name ?? "General"}_{_fechaInicio:yyyyMMdd}_{_fechaFin:yyyyMMdd}.pdf";
            await DescargarArchivo(contenido, nombreArchivo, "application/pdf");
            Snackbar.Add("Reporte exportado exitosamente a PDF", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar a PDF: {ex.Message}", Severity.Error);
        }
    }

    private async Task DescargarArchivo(byte[] contenido, string nombreArchivo, string contentType)
    {
        var base64 = Convert.ToBase64String(contenido);
        await JS.InvokeVoidAsync("fileDownloadHelper.downloadFile", nombreArchivo, contentType, base64);
    }
}

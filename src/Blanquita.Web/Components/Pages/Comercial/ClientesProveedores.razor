    private async Task CargarProveedores(int page)
    {
        _pageProveedor = page;
        _cargandoProveedores = true;
        try
        {
            var res = await CommercialApiService.GetProveedoresPaginadoAsync(_searchProveedor, _pageProveedor, _pageSizeProveedor, _onlyActiveProveedores, _username);
            _proveedores = res.Items ?? new List<CommercialProveedorDto>();
            _totalItemsProveedor = res.TotalItems;
            _totalPagesProveedor = Math.Max(1, res.TotalPages);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al consultar proveedores: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargandoProveedores = false;
        }
    }


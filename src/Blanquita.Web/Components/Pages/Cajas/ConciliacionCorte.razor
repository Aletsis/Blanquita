@page "/conciliacion-corte"
@using Blanquita.Application.DTOs
@using Blanquita.Application.Interfaces
@using Blanquita.Application.Queries.Conciliaciones
@using Blanquita.Application.Commands.Conciliaciones
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject IMediator Mediator
@inject ISupervisorService SupervisorService
@inject IBranchService BranchService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject ILogger<ConciliacionCorte> Logger
@inject IDialogService DialogService

<PageTitle>Conciliación de Corte</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 animate-fade-in">
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-6">
        <MudText Typo="Typo.h4" Class="font-weight-bold mb-2 mb-sm-0" Color="Color.Primary">
            <MudIcon Icon="@Icons.Material.Filled.Balance" Class="mr-2" Size="Size.Large" />
            Conciliación de Corte
        </MudText>
        
        <div class="d-flex align-center">
            <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.Store" Class="mr-2">
                Sucursal: @(_isAdmin && _supervisorBranchId <= 0 ? "Todas las sucursales" : _supervisorBranchName)
            </MudChip>
            <MudChip T="string" Color="@(_isAdmin ? Color.Success : Color.Primary)" Variant="Variant.Filled" Icon="@(_isAdmin ? Icons.Material.Filled.AdminPanelSettings : Icons.Material.Filled.Person)">
                @_supervisorName
            </MudChip>
        </div>
    </div>

        <MudGrid>
            <!-- Selección de Cajas en Móvil (Oculto en Desktop) -->
            <MudItem xs="12" Class="d-block d-md-none mb-2">
                <MudPaper Elevation="4" Class="pa-4 rounded-xl border-light bg-light shadow-sm">
                    <MudStack Spacing="3">
                        <MudDatePicker Label="Fecha de Búsqueda"
                                       Date="_selectedDate"
                                       DateChanged="OnDateChanged"
                                       Variant="Variant.Outlined"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                       Margin="Margin.Dense"
                                       MaxDate="DateTime.Today" />
                        <MudSelect T="int" 
                                   Label="Seleccionar Corte de Caja" 
                                   Value="_selectedShiftId" 
                                   ValueChanged="OnShiftSelected" 
                                   Variant="Variant.Outlined" 
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.Start" 
                                   AdornmentIcon="@Icons.Material.Filled.DesktopWindows">
                            <MudSelectItem T="int" Value="0">-- Seleccione un corte disponible --</MudSelectItem>
                            @foreach (var box in _boxes)
                            {
                                <MudSelectItem T="int" Value="@box.ShiftId">
                                    @box.Name (Apertura: @box.Time.ToString("HH:mm"))
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Columna de Selección de Cajas en Desktop (Oculto en Móvil) -->
            <MudItem xs="12" md="3" Class="d-none d-md-block">
                <MudPaper Elevation="4" Class="pa-4 rounded-xl h-100" Style="max-height: 80vh; overflow-y: auto;">
                    <MudText Typo="Typo.h6" Class="mb-4 px-2 font-weight-bold">Cortes Disponibles</MudText>
                    <MudDatePicker Label="Fecha de Búsqueda"
                                   Date="_selectedDate"
                                   DateChanged="OnDateChanged"
                                   Variant="Variant.Outlined"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                   Margin="Margin.Dense"
                                   MaxDate="DateTime.Today"
                                   Class="mb-4" />
                    <MudList T="int" Clickable="true" Color="Color.Primary">
                        @if (!_boxes.Any())
                        {
                            <div class="pa-4 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No hay cortes pendientes</MudText>
                            </div>
                        }
                        @foreach (var box in _boxes)
                        {
                            <MudListItem Value="@box.ShiftId" 
                                         OnClick="@(() => OnShiftSelected(box.ShiftId))"
                                         Class="@(_selectedShiftId == box.ShiftId ? "bg-primary-light rounded-lg" : "rounded-lg")">
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Class="mr-3" 
                                             Color="@(_selectedShiftId == box.ShiftId ? Color.Primary : (box.Status == 0 ? Color.Error : Color.Default))" />
                                    <div>
                                        <MudText Typo="Typo.body1" Class="@(_selectedShiftId == box.ShiftId ? "font-weight-bold" : "")">@box.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Primary">Apertura: @box.Time.ToString("HH:mm")</MudText>
                                        @if (box.Status == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block font-weight-bold">Caja sin corte</MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Primary">Cierre: @box.TimeClose?.ToString("HH:mm")</MudText>   
                                        }
                                    </div>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>

            <!-- Área Principal de Datos -->
            <MudItem xs="12" md="9">
                @if (_loading)
                {
                    <MudPaper Elevation="0" Class="d-flex align-center justify-center pa-12 rounded-xl h-100">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                        <MudText Class="ml-4">Cargando datos del sistema...</MudText>
                    </MudPaper>
                }
                else if (_result != null)
                {
                    <div class="animate-slide-up">
                        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-4 gap-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                 <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" />
                                 <MudText Typo="Typo.h6">Cajero: <b>@_result.CashierName</b></MudText>
                            </MudStack>
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="GuardarConciliacion"
                                       Disabled="@(_isSaving || !_result.IsClosed)"
                                       FullWidth="true"
                                       Class="rounded-xl px-6 shadow-sm max-w-sm-button">
                                @if (_isSaving)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Guardando...</MudText>
                                }
                                else
                                {
                                    <MudText>Guardar Conciliación</MudText>
                                }
                            </MudButton>
                        </div>

                        @if (!_result.IsClosed)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg shadow-sm">
                                La caja está <b>ABIERTA</b> en Contpaqi. Debe realizar el cierre de caja en el sistema POS para obtener los totales finales.
                            </MudAlert>
                        }

                        <MudGrid>
                            <!-- Tarjeta 1: Datos del Sistema (Contpaqi) -->
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="4" Class="rounded-xl overflow-hidden h-100 border-light">
                                    <div class="pa-4 bg-primary text-white shadow-sm">
                                        <MudText Typo="Typo.h6">Datos en Sistema (Contpaqi)</MudText>
                                    </div>
                                    <MudCardContent>
                                        <MudStack Spacing="3">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Color="Color.Secondary">Cobrado en Efectivo:</MudText>
                                                <MudText Typo="Typo.h6">@_result.CashCollected.ToString("C2", _mexicoCulture)</MudText>
                                            </div>
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Color="Color.Secondary">Cobrado con Tarjeta:</MudText>
                                                <MudText Typo="Typo.h6">@_result.CardCollected.ToString("C2", _mexicoCulture)</MudText>
                                            </div>
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Color="Color.Error">Devoluciones:</MudText>
                                                <MudText Typo="Typo.h6" Color="Color.Error">-@Math.Abs(_result.ReturnsTotal).ToString("C2", _mexicoCulture)</MudText>
                                            </div>
                                            <MudDivider />
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Total Vendido:</MudText>
                                                <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@_result.TotalSold.ToString("C2", _mexicoCulture)</MudText>
                                            </div>
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <!-- Tarjeta 2: Ingreso de Valores Físicos (Tarjetas y Efectivo) -->
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="4" Class="rounded-xl overflow-hidden h-100 border-light">
                                    <div class="pa-4 bg-secondary text-white shadow-sm">
                                        <MudText Typo="Typo.h6">Ingreso de Valores Físicos</MudText>
                                    </div>
                                    <MudCardContent>
                                        <MudStack Spacing="3">
                                            <div class="d-flex align-center gap-2">
                                                <MudNumericField @bind-Value="_terminalBanbajio" 
                                                                Culture="@_mexicoCulture" 
                                                                Label="Terminal Banbajio (Total)" 
                                                                Variant="Variant.Outlined" 
                                                                Adornment="Adornment.Start" 
                                                                AdornmentIcon="@Icons.Material.Filled.CreditCard" 
                                                                Format="N2" 
                                                                HideSpinButtons="true" 
                                                                Margin="Margin.Dense" 
                                                                Class="flex-grow-1" />
                                                <MudIconButton Icon="@Icons.Material.Filled.ListAlt" 
                                                              Color="Color.Primary" 
                                                              Size="Size.Medium" 
                                                              Title="Desglosar múltiples terminales Banbajío" 
                                                              OnClick="@(() => AbrirDesgloseTerminales("Banbajio"))" />
                                            </div>

                                            <div class="d-flex align-center gap-2">
                                                <MudNumericField @bind-Value="_terminalBanRegio" 
                                                                Culture="@_mexicoCulture" 
                                                                Label="Terminal BanRegio (Total)" 
                                                                Variant="Variant.Outlined" 
                                                                Adornment="Adornment.Start" 
                                                                AdornmentIcon="@Icons.Material.Filled.CreditCard" 
                                                                Format="N2" 
                                                                HideSpinButtons="true" 
                                                                Margin="Margin.Dense" 
                                                                Class="flex-grow-1" />
                                                <MudIconButton Icon="@Icons.Material.Filled.ListAlt" 
                                                              Color="Color.Primary" 
                                                              Size="Size.Medium" 
                                                              Title="Desglosar múltiples terminales BanRegio" 
                                                              OnClick="@(() => AbrirDesgloseTerminales("Banregio"))" />
                                            </div>

                                            <MudNumericField @bind-Value="_efectivoRecibido" 
                                                            Culture="@_mexicoCulture" 
                                                            Label="Efectivo en Caja (Físico)" 
                                                            Variant="Variant.Outlined" 
                                                            Adornment="Adornment.Start" 
                                                            AdornmentIcon="@Icons.Material.Filled.AttachMoney" 
                                                            Format="N2" 
                                                            HideSpinButtons="true" 
                                                            Margin="Margin.Dense" />
                                            
                                            <MudDivider />
                                            <div class="d-flex justify-space-between align-center mt-1">
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Total Tarjetas:</MudText>
                                                <MudText Typo="Typo.h6" Color="Color.Info" Class="font-weight-bold">@TarjetasFisicas.ToString("C2", _mexicoCulture)</MudText>
                                            </div>
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <!-- Tarjeta 3: Salidas de Efectivo y Recolecciones -->
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="4" Class="rounded-xl pa-4 bg-light border-light shadow-sm h-100">
                                    <div class="d-flex justify-space-between align-center mb-3">
                                        <MudText Typo="Typo.h6" Color="Color.Primary">
                                            <MudIcon Icon="@Icons.Material.Filled.LocalAtm" Class="mr-2" />
                                            Efectivo y Salidas
                                        </MudText>
                                        <MudButton Variant="Variant.Outlined" 
                                                   Color="Color.Error" 
                                                   StartIcon="@Icons.Material.Filled.Add" 
                                                   Size="Size.Small" 
                                                   OnClick="AbrirDialogoAgregarSalida">
                                            Salida de Efectivo
                                        </MudButton>
                                    </div>

                                    <div class="d-flex justify-space-between align-center py-1">
                                        <MudText Typo="Typo.body2">Recolecciones (Sis):</MudText>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold">@_result.TotalRecolectado.ToString("C2", _mexicoCulture)</MudText>
                                    </div>

                                    <div class="d-flex justify-space-between align-center py-1">
                                        <MudText Typo="Typo.body2">Salidas de Efectivo:</MudText>
                                        <MudText Typo="Typo.h6" Color="Color.Error" Class="font-weight-bold">@TotalSalidasEfectivo.ToString("C2", _mexicoCulture)</MudText>
                                    </div>

                                    @if (_salidas.Any())
                                    {
                                        <MudTable Items="_salidas" Dense="true" Elevation="0" Outlined="true" Class="mt-2 mb-2">
                                            <HeaderContent>
                                                <MudTh>Motivo</MudTh>
                                                <MudTh Style="text-align: right;">Monto</MudTh>
                                                <MudTh Style="width: 30px;"></MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Motivo">
                                                    <MudText Typo="Typo.caption" Class="d-block font-weight-bold">@context.Motivo</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Aut: @context.QuienAutoriza</MudText>
                                                </MudTd>
                                                <MudTd DataLabel="Monto" Style="text-align: right;">
                                                    <MudText Typo="Typo.caption" Class="font-weight-bold">@context.Monto.ToString("C2", _mexicoCulture)</MudText>
                                                </MudTd>
                                                <MudTd Style="text-align: center;">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => _salidas.Remove(context))" />
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }

                                    <MudDivider Class="my-2" />
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Total Efectivo Justificado:</MudText>
                                        <MudText Typo="Typo.h6" Color="Color.Success" Class="font-weight-bold">@TotalEfectivoEntregado.ToString("C2", _mexicoCulture)</MudText>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                                        Total = Recolecciones (@_result.TotalRecolectado.ToString("C2", _mexicoCulture)) + Efectivo Caja (@_efectivoRecibido.ToString("C2", _mexicoCulture)) + Salidas (@TotalSalidasEfectivo.ToString("C2", _mexicoCulture))
                                    </MudText>
                                </MudCard>
                            </MudItem>

                            <!-- Tarjeta 4: Resultados de Conciliación -->
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="4" Class="rounded-xl overflow-hidden shadow-lg border-primary h-100">
                                    <div class="pa-4 bg-dark text-white">
                                        <MudText Typo="Typo.h6">Diferencias Finales</MudText>
                                    </div>
                                    <MudCardContent>
                                        <MudStack Spacing="3">
                                            <!-- Diferencia en Tarjetas -->
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body1">Dif. en Tarjetas:</MudText>
                                                <MudText Typo="Typo.h6" Color="@(DiferenciaTarjeta == 0 ? Color.Success : Color.Error)">
                                                    @DiferenciaTarjeta.ToString("C2", _mexicoCulture)
                                                </MudText>
                                            </div>
                                            
                                            <!-- Efectivo Esperado Calculation -->
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Efectivo Esperado en Caja:</MudText>
                                                <MudText Typo="Typo.body1">@EfectivoEsperado.ToString("C2", _mexicoCulture)</MudText>
                                            </div>

                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Entregado Global:</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@((TotalEfectivoEntregado + TarjetasFisicas).ToString("C2", _mexicoCulture))</MudText>
                                            </div>

                                            <MudDivider />
                                            
                                            <!-- Diferencia Final en Efectivo -->
                                            <div class="d-flex justify-space-between align-center pt-2">
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">DIFERENCIA EFECTIVO:</MudText>
                                                <MudChip T="string" Color="@(DiferenciaEfectivo == 0 ? Color.Success : (DiferenciaEfectivo > 0 ? Color.Warning : Color.Error))" 
                                                         Variant="Variant.Filled" Size="Size.Large" Class="font-weight-bold">
                                                    @DiferenciaEfectivo.ToString("C2", _mexicoCulture)
                                                </MudChip>
                                            </div>
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </div>
                }
                else if (_hasSearched)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-16 d-flex flex-column align-center justify-center rounded-xl border-dashed border-2 bg-light">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" Style="opacity:0.5" />
                        <MudText Typo="Typo.h6" Class="mt-4">No se encontraron datos</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-16 d-flex flex-column align-center justify-center rounded-xl border-dashed border-2 bg-light h-100 min-h-300">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Default" Style="opacity:0.5" />
                        <MudText Typo="Typo.h6" Class="mt-4 text-center">Seleccione un corte de caja para comenzar la conciliación</MudText>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
        <MudOverlay Visible="_isProcessing" LightBackground="true" Absolute="false" ZIndex="9999">
            <div class="d-flex flex-column align-center justify-center">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Class="mt-4 font-weight-bold" Color="Color.Primary">Cargando...</MudText>
            </div>
        </MudOverlay>
    </MudContainer>
}

<style>
    .animate-fade-in { animation: fadeIn 0.5s ease-out; }
    .animate-slide-up { animation: slideUp 0.5s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .rounded-xl { border-radius: 16px !important; }
    .bg-primary-light { background-color: rgba(25, 118, 210, 0.08); }
    .border-light { border: 1px solid rgba(0,0,0,0.08) !important; }
    .bg-light { background-color: #fafafa; }
    .bg-dark { background-color: #424242; }
    .border-primary { border: 2px solid #1976d2 !important; }
    .font-weight-bold { font-weight: 700; }
    .min-h-300 { min-height: 300px; }
    
    @@media (max-width: 599.98px) {
        .max-w-sm-button {
            width: 100% !important;
        }
    }
</style>

@code {
    private bool _isAdmin;
    private int _supervisorBranchId;
    private string _supervisorBranchName = string.Empty;
    private string _supervisorName = string.Empty;

    private int? ActiveBranchId => _isAdmin ? (_supervisorBranchId > 0 ? _supervisorBranchId : (int?)null) : (_supervisorBranchId > 0 ? _supervisorBranchId : (int?)null);

    // Lógica del negocio
    private List<AvailableBoxDto> _boxes = new();
    private int _selectedShiftId;
    private int _selectedBoxId;
    private bool _loading;
    private bool _hasSearched;
    private bool _isProcessing;
    private bool _isSaving;
    private ConciliacionResultDto? _result;
    private DateTime? _selectedDate = DateTime.Today;
    
    // Inputs del usuario
    private System.Globalization.CultureInfo _mexicoCulture = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
    private decimal _terminalBanbajio;
    private decimal _terminalBanRegio;
    private decimal _efectivoRecibido;
    private List<ConciliacionSalidaEfectivoDto> _salidas = new();
    private List<TerminalDetalleDto> _terminales = new();

    // Fórmulas de Diferencias
    private decimal TarjetasFisicas => Math.Round(_terminalBanbajio + _terminalBanRegio, 2, MidpointRounding.AwayFromZero);
    private decimal TotalSalidasEfectivo => Math.Round(_salidas.Sum(s => s.Monto), 2, MidpointRounding.AwayFromZero);
    private decimal TotalEfectivoEntregado => Math.Round((_result?.TotalRecolectado ?? 0) + _efectivoRecibido + TotalSalidasEfectivo, 2, MidpointRounding.AwayFromZero);
    
    // Diferencia Tarjeta = Físico (TarjetasFisicas) - Sistema (CardCollected)
    private decimal DiferenciaTarjeta => Math.Round(TarjetasFisicas - (_result?.CardCollected ?? 0), 2, MidpointRounding.AwayFromZero);

    // Efectivo Esperado = Total Vendido - Devoluciones - Efectivo Recolectado - TarjetasFisicas - SalidasEfectivo
    private decimal EfectivoEsperado => Math.Round((_result?.TotalSold ?? 0) - Math.Abs(_result?.ReturnsTotal ?? 0) - (_result?.TotalRecolectado ?? 0) - TarjetasFisicas - TotalSalidasEfectivo, 2, MidpointRounding.AwayFromZero);
    
    // Diferencia Efectivo = Efectivo Recibido - Efectivo Esperado
    private decimal DiferenciaEfectivo => Math.Round(_efectivoRecibido - EfectivoEsperado, 2, MidpointRounding.AwayFromZero);

    protected override async Task OnInitializedAsync()
    {
        await LoadUserSessionAsync();
    }

    private async Task LoadUserSessionAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole("Admin");
            
            var fullNameClaim = user.FindFirst("FullName")?.Value;
            var branchIdClaim = user.FindFirst("BranchId")?.Value;
            var username = user.Identity?.Name ?? string.Empty;

            _supervisorName = !string.IsNullOrWhiteSpace(fullNameClaim) ? fullNameClaim : username;

            if (int.TryParse(branchIdClaim, out int branchId) && branchId > 0)
            {
                _supervisorBranchId = branchId;
                var branch = await BranchService.GetByIdAsync(branchId);
                _supervisorBranchName = branch?.Name ?? "Desconocida";
            }
            else
            {
                _supervisorBranchId = 0;
                _supervisorBranchName = _isAdmin ? "Todas las sucursales" : string.Empty;
            }

            await CargarCajas();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar sesión de usuario en Conciliación");
            Snackbar.Add("Error al cargar la información del usuario", Severity.Error);
        }
    }

    private async Task OnDateChanged(DateTime? newDate)
    {
        _selectedDate = newDate;
        _selectedShiftId = 0;
        _selectedBoxId = 0;
        _result = null;
        _hasSearched = false;
        await CargarCajas();
    }

    private async Task CargarCajas()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var dateToQuery = _selectedDate ?? DateTime.Today;
            _boxes = (await Mediator.Send(new GetAvailableBoxesQuery(dateToQuery, ActiveBranchId))).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar cajas para conciliación");
            Snackbar.Add("Error al cargar cajas disponibles", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SeleccionarCaja(AvailableBoxDto box)
    {
        if (_isProcessing || _loading) return;
        _selectedBoxId = box.Id;
        _selectedShiftId = box.ShiftId;
        await CargarDatos();
    }

    private async Task OnShiftSelected(int shiftId)
    {
        if (_isProcessing || _loading) return;
        _selectedShiftId = shiftId;
        var selectedBox = _boxes.FirstOrDefault(b => b.ShiftId == shiftId);
        _selectedBoxId = selectedBox?.Id ?? 0;
        
        if (_selectedShiftId > 0)
        {
            await CargarDatos();
        }
        else
        {
            _result = null;
            _hasSearched = false;
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        if (_selectedShiftId == 0 || _isProcessing) return;

        _isProcessing = true;
        _loading = true;
        _hasSearched = true;
        _result = null;
        _terminalBanbajio = 0;
        _terminalBanRegio = 0;
        _efectivoRecibido = 0;
        _salidas.Clear();
        _terminales.Clear();
        StateHasChanged();

        try
        {
            Logger.LogInformation("Iniciando carga de datos de conciliación para ShiftId: {ShiftId}", _selectedShiftId);
            var query = new GetConciliacionQuery(_selectedBoxId, _selectedShiftId, 0, _selectedDate ?? DateTime.Today);
            _result = await Mediator.Send(query);
            
            if (_result == null)
            {
                Logger.LogWarning("La consulta GetConciliacionQuery devolvió null para ShiftId: {ShiftId}", _selectedShiftId);
                Snackbar.Add("No se encontraron datos para el turno seleccionado", Severity.Warning);
            }
            else 
            {
                Logger.LogInformation("Datos cargados exitosamente para {Caja}", _result.CashRegisterName);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ERROR FATAL en CargarDatos para ShiftId: {ShiftId}. Mensaje: {Message}", _selectedShiftId, ex.Message);
            Snackbar.Add(Blanquita.Web.Helpers.ExceptionHelper.GetLocalizedExceptionMessage(ex), Severity.Error);
        }
        finally
        {
            _loading = false;
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task AbrirDesgloseTerminales(string banco)
    {
        var parameters = new DialogParameters<DialogoDesgloseTerminales>
        {
            { x => x.Banco, banco },
            { x => x.TerminalesExistentes, _terminales }
        };

        var dialog = await DialogService.ShowAsync<DialogoDesgloseTerminales>($"Desglose de Terminales - {banco}", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is List<TerminalDetalleDto> terminalesActualizadas)
        {
            _terminales.RemoveAll(t => string.Equals(t.Banco, banco, StringComparison.OrdinalIgnoreCase));
            _terminales.AddRange(terminalesActualizadas);

            var sumaBanco = Math.Round(terminalesActualizadas.Sum(t => t.Monto), 2, MidpointRounding.AwayFromZero);
            if (string.Equals(banco, "Banbajio", StringComparison.OrdinalIgnoreCase))
            {
                _terminalBanbajio = sumaBanco;
            }
            else
            {
                _terminalBanRegio = sumaBanco;
            }
            StateHasChanged();
        }
    }

    private async Task AbrirDialogoAgregarSalida()
    {
        var parameters = new DialogParameters<DialogoAgregarSalidaEfectivo>
        {
            { x => x.UsuarioActual, _supervisorName }
        };

        var dialog = await DialogService.ShowAsync<DialogoAgregarSalidaEfectivo>("Registrar Salida de Efectivo", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ConciliacionSalidaEfectivoDto nuevaSalida)
        {
            _salidas.Add(nuevaSalida);
            StateHasChanged();
        }
    }

    private async Task GuardarConciliacion()
    {
        if (_result == null || _isSaving) return;
        if (!_result.IsClosed)
        {
            Snackbar.Add("No se puede guardar una conciliación si la caja sigue abierta.", Severity.Error);
            return;
        }
        if (Math.Abs(DiferenciaEfectivo) >= 0.01m)
        {
            await DialogService.ShowMessageBoxAsync(
                "No se puede guardar el corte",
                "No se puede guardar este corte porque existe una diferencia en efectivo. Por favor, cuadre los valores antes de continuar.",
                yesText: "Aceptar"
            );
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var command = new SaveConciliacionCorteCommand(
                ShiftId: _selectedShiftId,
                BranchName: _result.BranchName,
                CashRegisterName: _result.CashRegisterName,
                CashierName: _result.CashierName,
                TotalRecolecciones: _result.TotalRecolectado,
                EfectivoEntregado: _efectivoRecibido,
                Banregio: _terminalBanRegio,
                Banbajio: _terminalBanbajio,
                ReturnsTotal: _result.ReturnsTotal,
                TotalSold: _result.TotalSold,
                Fecha: _result.Fecha,
                SalidasEfectivo: TotalSalidasEfectivo,
                Usuario: _supervisorName,
                Salidas: _salidas,
                Terminales: _terminales
            );

            await Mediator.Send(command);
            Snackbar.Add("Conciliación guardada exitosamente", Severity.Success);

            // Limpiar selección actual y recargar cajas (el corte desaparecerá porque ya está guardado)
            _selectedShiftId = 0;
            _selectedBoxId = 0;
            _result = null;
            _salidas.Clear();
            _terminales.Clear();
            await CargarCajas();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar conciliación de corte");
            Snackbar.Add($"Error al guardar conciliación: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }
}

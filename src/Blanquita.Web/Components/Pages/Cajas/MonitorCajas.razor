@code {
    private readonly CultureInfo _mexicoCulture = new("es-MX");
    private decimal _limiteEfectivoAlerta = 8000m; // Umbral configurable para la alerta de recolección (por defecto $8,000)

    private int _supervisorBranchId;
    private string _supervisorBranchName = string.Empty;
    private string _supervisorName = string.Empty;
    private bool _isAdmin;

    private DateTime? _selectedDate = DateTime.Today;
    private int _selectedBranchId = 0;
    private string _selectedBranchName = string.Empty;
    private List<BranchDto> _branches = new();
    private List<CajaMonitorDto> _cajas = new();

    private string _searchQuery = string.Empty;
    private int? _selectedStatusFilter = null; // null = Todas, 0 = Abiertas, 1 = Cerradas, 2 = Conciliadas
    private HashSet<int> _expandedRecos = new();

    private bool _isLoading = false;
    private DateTime? _lastRefreshTime;
    private int _refreshIntervalSeconds = 60; // 1 minuto por defecto
    private CancellationTokenSource? _timerCts;

    // Métricas calculadas globales
    private decimal TotalCobradoGlobal => _cajas.Sum(c => c.TotalSold);
    private decimal TotalEfectivoGlobal => _cajas.Sum(c => c.CashCollected);
    private decimal TotalTarjetasGlobal => _cajas.Sum(c => c.CardCollected);
    private decimal TotalRecolectadoGlobal => _cajas.Sum(c => c.TotalRecolectado);
    private int TotalRecoleccionesCountGlobal => _cajas.Sum(c => c.TotalRecoleccionesCount);
    private decimal EfectivoEstimadoGlobal => _cajas.Sum(c => c.EfectivoEstimadoEnCaja);

    // Filtrado de cajas en vista
    private IEnumerable<CajaMonitorDto> CajasFiltradas
    {
        get
        {
            var query = _cajas.AsEnumerable();

            // Filtro por estado
            if (_selectedStatusFilter == 0)
                query = query.Where(c => !c.IsClosed);
            else if (_selectedStatusFilter == 1)
                query = query.Where(c => c.IsClosed);
            else if (_selectedStatusFilter == 2)
                query = query.Where(c => c.IsConciliated);

            // Filtro por texto de búsqueda
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var term = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(c =>
                    c.CashRegisterName.ToLowerInvariant().Contains(term) ||
                    c.CashierName.ToLowerInvariant().Contains(term) ||
                    c.BranchName.ToLowerInvariant().Contains(term) ||
                    c.ShiftId.ToString().Contains(term));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserSessionAsync();
        StartAutoRefreshTimer();
    }

    private async Task LoadUserSessionAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole("Admin");

            var fullNameClaim = user.FindFirst("FullName")?.Value;
            var branchIdClaim = user.FindFirst("BranchId")?.Value;
            var username = user.Identity?.Name ?? string.Empty;

            _supervisorName = !string.IsNullOrWhiteSpace(fullNameClaim) ? fullNameClaim : username;

            if (int.TryParse(branchIdClaim, out int branchId) && branchId > 0)
            {
                _supervisorBranchId = branchId;
                var branch = await BranchService.GetByIdAsync(branchId);
                _supervisorBranchName = branch?.Name ?? "Desconocida";
                _selectedBranchId = branchId;
                _selectedBranchName = _supervisorBranchName;
            }
            else
            {
                _supervisorBranchId = 0;
                _supervisorBranchName = _isAdmin ? "Todas las sucursales" : string.Empty;
                _selectedBranchId = 0;
                _selectedBranchName = "Todas las sucursales";
            }

            if (!_isAdmin && _supervisorBranchId <= 0)
            {
                Snackbar.Add("⚠️ Su usuario no tiene una sucursal asignada. Pida a un administrador que se la asigne.", Severity.Warning);
            }

            if (_isAdmin)
            {
                var allBranches = await BranchService.GetAllAsync();
                _branches = allBranches.ToList();
            }

            // Cargar umbral de alerta configurado de forma permanente en el sistema
            try
            {
                var sysConfig = await ConfigService.ObtenerConfiguracionAsync();
                if (sysConfig.UmbralAlertaEfectivoCaja > 0)
                {
                    _limiteEfectivoAlerta = sysConfig.UmbralAlertaEfectivoCaja;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "No se pudo cargar el umbral de alerta desde la configuración; se usará el valor por defecto.");
            }

            await CargarDatos(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al inicializar sesión en Monitor de Cajas");
            Snackbar.Add("Error al cargar la información del usuario", Severity.Error);
        }
    }

    private async Task CargarDatos(bool silent = false)
    {
        if (_isLoading) return;

        if (!silent)
        {
            _isLoading = true;
            StateHasChanged();
        }

        try
        {
            try
            {
                var sysConfig = await ConfigService.ObtenerConfiguracionAsync();
                if (sysConfig.UmbralAlertaEfectivoCaja > 0)
                {
                    _limiteEfectivoAlerta = sysConfig.UmbralAlertaEfectivoCaja;
                }
            }
            catch
            {
                // Silencioso al recargar configuración
            }

            var targetDate = _selectedDate ?? DateTime.Today;
            int? branchFilter = _selectedBranchId > 0 ? _selectedBranchId : (_supervisorBranchId > 0 ? _supervisorBranchId : (int?)null);

            var query = new GetMonitorCajasQuery(targetDate, branchFilter);
            var result = await Mediator.Send(query);
            _cajas = result.ToList();
            _lastRefreshTime = DateTime.Now;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar datos en Monitor de Cajas");
            if (!silent)
            {
                Snackbar.Add($"Error al cargar monitor de cajas: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnDateChanged(DateTime? newDate)
    {
        _selectedDate = newDate;
        await CargarDatos(false);
    }

    private async Task OnBranchChanged(int branchId)
    {
        _selectedBranchId = branchId;
        var found = _branches.FirstOrDefault(b => b.Id == branchId);
        _selectedBranchName = found?.Name ?? (branchId == 0 ? "Todas las sucursales" : string.Empty);
        await CargarDatos(false);
    }

    private void OnRefreshIntervalChanged(int intervalSeconds)
    {
        _refreshIntervalSeconds = intervalSeconds;
        StartAutoRefreshTimer();
        Snackbar.Add(_refreshIntervalSeconds > 0 
            ? $"Auto-actualización configurada cada {_refreshIntervalSeconds} segundos" 
            : "Auto-actualización desactivada", Severity.Info);
    }

    private void StartAutoRefreshTimer()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        _timerCts = null;

        if (_refreshIntervalSeconds <= 0) return;

        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;

        _ = Task.Run(async () =>
        {
            using var periodicTimer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshIntervalSeconds));
            while (!token.IsCancellationRequested)
            {
                try
                {
                    if (await periodicTimer.WaitForNextTickAsync(token))
                    {
                        await InvokeAsync(async () =>
                        {
                            await CargarDatos(silent: true);
                        });
                    }
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Error en ciclo de auto-refresco del Monitor de Cajas");
                }
            }
        }, token);
    }

    private void ToggleRecos(int shiftId)
    {
        if (_expandedRecos.Contains(shiftId))
            _expandedRecos.Remove(shiftId);
        else
            _expandedRecos.Add(shiftId);
    }

    private async Task VerDesgloseRecoleccion(CashCollectionDto item)
    {
        var parameters = new DialogParameters<DialogoDetalleRecoleccion>
        {
            { x => x.Recoleccion, item }
        };

        await DialogService.ShowAsync<DialogoDetalleRecoleccion>(
            $"Desglose de Recolección - Folio #{item.Folio}",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = true
            });
    }

    private void IrARecoleccion(int cashRegisterId)
    {
        NavigationManager.NavigateTo($"/recoleccion?cashRegisterId={cashRegisterId}");
    }

    private void IrACorte(int cashRegisterId)
    {
        NavigationManager.NavigateTo($"/corte-caja?cashRegisterId={cashRegisterId}");
    }

    private void IrAConciliacion(int shiftId)
    {
        NavigationManager.NavigateTo($"/conciliacion-corte?shiftId={shiftId}");
    }

    private string GetCardClass(CajaMonitorDto caja)
    {
        return "card-monitor h-100";
    }

    private string GetCardHeaderClass(CajaMonitorDto caja)
    {
        return caja.IsClosed ? "card-header-closed" : "card-header-active";
    }

    private string FormatearTiempoTranscurrido(DateTime horaApertura)
    {
        var diff = DateTime.Now - horaApertura;
        if (diff.TotalMinutes < 1) return "recién abierta";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m";
        return $"{(int)diff.TotalHours}h {diff.Minutes}m";
    }

    public async ValueTask DisposeAsync()
    {
        if (_timerCts != null)
        {
            _timerCts.Cancel();
            _timerCts.Dispose();
            _timerCts = null;
        }
    }
}

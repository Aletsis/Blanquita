@page "/recoleccion"
@using Blanquita.Application.DTOs
@using Blanquita.Application.Interfaces
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using System.Globalization
@using Blanquita.Application.Queries.Supervisors
@using Blanquita.Application.Queries.Cashiers
@using Blanquita.Application.Queries.Conciliaciones
@using Blanquita.Application.Commands.Cajas
@using Blanquita.Application.Helpers
@using MediatR
@using Microsoft.AspNetCore.Components.Authorization
@inject ISnackbar Snackbar
@inject IMediator Mediator
@inject ISupervisorService SupervisorService
@inject IBranchService BranchService
@inject IUserService UserService
@inject ICashRegisterService CashRegisterService
@inject IJSRuntime JSRuntime
@inject ILogger<RecoCaja> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Recolección de Efectivo</PageTitle>

@if (!IsUserAuthorized)
{
    <!-- Pantalla de Autenticación Inline por Nómina -->
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center animate-fade-in" Style="min-height: 80vh;">
        <MudPaper Elevation="8" Class="pa-8 rounded-xl" Style="width: 100%; max-width: 450px;">
            <MudStack Spacing="4">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="width: 70px; height: 70px;">
                        <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold">Acceso de Encargada</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Ingrese su número de nómina para comenzar la conciliación
                    </MudText>
                </MudStack>

                <EditForm Model="this" OnValidSubmit="ValidarNomina">
                    <MudStack Spacing="3">
                        <MudNumericField @bind-Value="_employeeNumberInput"
                                         Label="Número de Nómina"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Required="true"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Numbers"
                                         HideSpinButtons="true" />

                        @if (!string.IsNullOrEmpty(_authErrorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="rounded-lg">@_authErrorMessage</MudAlert>
                        }

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Class="rounded-xl mt-2"
                                   Disabled="@_checkingSupervisor">
                            @if (_checkingSupervisor)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Validando...</MudText>
                            }
                            else
                            {
                                <MudText>Ingresar</MudText>
                            }
                        </MudButton>

                        <MudDivider Class="my-2" />

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Login"
                                   Href="/login?returnUrl=/recoleccion"
                                   Class="rounded-xl">
                            Cambiar a login de usuario
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 animated fadeIn">
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-6">
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-2 mb-sm-0" Style="background: linear-gradient(45deg, #2e7d32, #66bb6a); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="mr-2" Size="Size.Large" Color="Color.Success" />
                Recolección de Efectivo
            </MudText>

            <div class="d-flex align-center">
                @if (_isSupervisorAuthenticated)
                {
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.Store" Class="mr-2">
                        Sucursal: @_supervisorBranchName
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Person">
                        @_supervisorName
                    </MudChip>
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Error" OnClick="LogoutSupervisor" Class="ml-1" Title="Salir" />
                }
                else
                {
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.Store" Class="mr-2">
                        Sucursal: @(_isAdmin ? "Todas las sucursales" : _supervisorBranchName)
                    </MudChip>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.AdminPanelSettings">
                        @(_isAdmin ? $"Admin ({_supervisorName})" : _supervisorName)
                    </MudChip>
                }
            </div>
        </div>

        @if (_isError && !string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4 animate-fade-in" Elevation="2">
                <MudText Typo="Typo.body1"><strong>Error:</strong> @_errorMessage</MudText>
            </MudAlert>
        }

        @if (!_isError && _isSubmitting)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4 animate-fade-in" Elevation="2">
                <div class="d-flex align-center">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-3" />
                    <MudText Typo="Typo.body1">Procesando recolección...</MudText>
                </div>
            </MudAlert>
        }

        <MudGrid>
            <!-- Sección de Selección -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="4" Class="pa-4 rounded-lg animate-slide-up">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                                Información del Personal
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudPaper Elevation="0" Class="pa-3 rounded-lg border-light bg-light d-flex align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Color="Color.Primary" Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Encargada / Responsable</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-bold">@_supervisorName</MudText>
                                @if (!string.IsNullOrEmpty(_supervisorBranchName) && !_isAdmin)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Info">Sucursal: @_supervisorBranchName</MudText>
                                }
                                else if (_isAdmin)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Success">Todas las sucursales (Administrador)</MudText>
                                }
                            </div>
                        </MudPaper>

                        <MudSelect T="int" 
                                Label="Seleccione caja" 
                                Value="_selectedCashRegisterId" 
                                ValueChanged="@(async (int value) => await OnCashRegisterChanged(value))"
                                Variant="Variant.Outlined"
                                AnchorOrigin="Origin.BottomCenter"
                                Class="mb-4"
                                Disabled="@_isSubmitting"
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.PointOfSale">
                            @if (_isLoadingBoxes)
                            {
                                <MudSelectItem T="int" Value="0">
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    Cargando cajas disponibles...
                                </MudSelectItem>
                            }
                            else if (_availableBoxes == null || !_availableBoxes.Any())
                            {
                                <MudSelectItem T="int" Value="0">
                                    -- No hay cajas con apertura disponibles --
                                </MudSelectItem>
                            }
                            else
                            {
                                <MudSelectItem T="int" Value="0">-- Seleccione una caja --</MudSelectItem>
                                @foreach (var box in _availableBoxes)
                                {
                                    <MudSelectItem T="int" Value="@box.Id">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Class="mr-2"/>
                                            @box.Name (Apertura: @box.Time.ToString("HH:mm"))
                                        </div>
                                    </MudSelectItem>
                                }
                            }
                        </MudSelect>

                        @if (!string.IsNullOrEmpty(_resolvedCashierName))
                        {
                            <MudPaper Elevation="0" Class="pa-3 rounded-lg border-light bg-light d-flex align-center mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" Class="mr-2" />
                                <MudText Typo="Typo.body1">Cajera asignada: <b>@_resolvedCashierName</b></MudText>
                            </MudPaper>
                        }
                        else if (_selectedCashRegisterId > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="rounded-lg mb-4">
                                No se pudo auto-resolver la cajera para este turno.
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Sección de Denominaciones -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="4" Class="pa-4 rounded-lg animate-slide-up" Style="animation-delay: 0.1s;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Color="Color.Success">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mr-2" />
                                Denominaciones
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_c1000" 
                                            Label="Billetes de $1000" 
                                            Variant="Variant.Outlined" 
                                            Min="0"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Money"
                                            AdornmentColor="Color.Success" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_c500" 
                                            Label="Billetes de $500" 
                                            Variant="Variant.Outlined" 
                                            Min="0"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Money"
                                            AdornmentColor="Color.Success" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_c200" 
                                            Label="Billetes de $200" 
                                            Variant="Variant.Outlined" 
                                            Min="0"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Money"
                                            AdornmentColor="Color.Info" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_c100" 
                                            Label="Billetes de $100" 
                                            Variant="Variant.Outlined" 
                                            Min="0"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Money"
                                            AdornmentColor="Color.Info" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_c50" 
                                            Label="Billetes de $50" 
                                            Variant="Variant.Outlined" 
                                            Min="0"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Money"
                                            AdornmentColor="Color.Warning" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_c20" 
                                            Label="Billetes de $20" 
                                            Variant="Variant.Outlined" 
                                            Min="0"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Money"
                                            AdornmentColor="Color.Warning" />
                            </MudItem>
                        </MudGrid>

                        <MudDivider Class="my-4" />

                        <div class="d-flex justify-center flex-column align-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Total a Recolectar</MudText>
                            <MudPaper Elevation="3" Class="pa-4 rounded-lg" Style="background: linear-gradient(135deg, #2e7d32 0%, #66bb6a 100%);">
                                <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: white;">
                                    $ @CalculateTotal().ToString("N2", CultureInfo.InvariantCulture)
                                </MudText>
                            </MudPaper>
                        </div>
                    </MudCardContent>
                    <MudCardActions Class="d-flex justify-center pa-4">
                        <MudButton Variant="Variant.Filled"
                                Color="Color.Success"
                                OnClick="@ImprimirReco"
                                Disabled="@_isSubmitting"
                                Size="Size.Large"
                                StartIcon="@Icons.Material.Filled.Print"
                                FullWidth="true"
                                Class="py-3 elevation-4">
                            @if (_isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <text>Procesando...</text>
                            }
                            else
                            {
                                <text>Imprimir Recolección</text>
                            }
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }
    .animate-slide-up {
        animation: slideUp 0.5s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    .rounded-lg {
        border-radius: 12px !important;
    }
</style>

@code {
    private bool _isUserAuthenticated;
    private bool _isSupervisorAuthenticated;
    private bool IsUserAuthorized => _isUserAuthenticated || _isSupervisorAuthenticated;
    private int _employeeNumberInput;
    private string _authErrorMessage = string.Empty;
    private bool _checkingSupervisor;
    private int _supervisorBranchId;
    private string _supervisorBranchName = string.Empty;
    private string _supervisorName = string.Empty;
    private bool _isAdmin;
    private SupervisorDto? _selectedSupervisor;
    private int _selectedCashierId = 0;
    private int _selectedCashRegisterId = 0;
    private List<AvailableBoxDto> _availableBoxes = new();
    private string? _resolvedCashierName;
    private bool _isLoadingBoxes = false;

    // Denominations
    private int _c1000 = 0;
    private int _c500 = 0;
    private int _c200 = 0;
    private int _c100 = 0;
    private int _c50 = 0;
    private int _c20 = 0;

    private int _total = 0;
    private bool _isError = false;
    private bool _isSubmitting = false;
    private string _errorMessage = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAuthSession();
        }
    }

    private async Task CheckAuthSession()
    {
        try
        {
            // 1. Validar si está logueado como usuario estándar en el sistema
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                if (!user.IsInRole("Admin") && !user.IsInRole("Supervisor"))
                {
                    _authErrorMessage = "No tienes permisos para acceder a esta sección.";
                    StateHasChanged();
                    return; // Cae al formulario de nómina
                }
                _isUserAuthenticated = true;
                _isAdmin = user.IsInRole("Admin");
                var username = user.Identity.Name ?? string.Empty;
                var userDto = await UserService.GetByUsernameAsync(username);

                // Intentar resolver supervisor desde el usuario
                if (userDto != null)
                {
                    if (userDto.EmployeeNumber.HasValue)
                    {
                        _selectedSupervisor = await SupervisorService.GetByEmployeeNumberAsync(userDto.EmployeeNumber.Value);
                    }
                    if (_selectedSupervisor == null && !string.IsNullOrWhiteSpace(userDto.FullName))
                    {
                        _selectedSupervisor = await SupervisorService.GetByNameAsync(userDto.FullName);
                    }
                    if (_selectedSupervisor == null && !string.IsNullOrWhiteSpace(userDto.Username))
                    {
                        _selectedSupervisor = await SupervisorService.GetByNameAsync(userDto.Username);
                    }

                    if (_selectedSupervisor != null)
                    {
                        _supervisorName = _selectedSupervisor.Name;
                        _supervisorBranchId = _selectedSupervisor.BranchId;
                    }
                    else
                    {
                        _supervisorName = !string.IsNullOrWhiteSpace(userDto.FullName) ? userDto.FullName : userDto.Username;
                        _supervisorBranchId = userDto.BranchId ?? 0;
                    }
                }
                else
                {
                    _supervisorName = username;
                }

                if (_supervisorBranchId > 0)
                {
                    var branch = await BranchService.GetByIdAsync(_supervisorBranchId);
                    _supervisorBranchName = branch?.Name ?? "Desconocida";
                }
                else
                {
                    _supervisorBranchName = _isAdmin ? "Todas las sucursales" : string.Empty;
                }

                StateHasChanged();
                await CargarCajas();
                return;
            }

            // 2. Si no, validar si está logueado temporalmente por número de nómina en sessionStorage
            var storedNominaStr = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "supervisor_nomina");
            if (int.TryParse(storedNominaStr, out int storedNomina))
            {
                var supervisor = await SupervisorService.GetByEmployeeNumberAsync(storedNomina);
                if (supervisor != null && supervisor.IsActive)
                {
                    _isSupervisorAuthenticated = true;
                    _selectedSupervisor = supervisor;
                    _supervisorBranchId = supervisor.BranchId;
                    _supervisorName = supervisor.Name;
                    
                    var branches = await BranchService.GetAllAsync();
                    _supervisorBranchName = branches.FirstOrDefault(b => b.Id == supervisor.BranchId)?.Name ?? "Desconocida";
                    
                    StateHasChanged();
                    await CargarCajas();
                    return;
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al comprobar sesión de autenticación");
        }
    }

    private async Task CargarCajas()
    {
        _isLoadingBoxes = true;
        StateHasChanged();
        try
        {
            int? branchFilter = _isAdmin ? null : (_supervisorBranchId > 0 ? _supervisorBranchId : (int?)null);
            var data = await Mediator.Send(new GetAvailableBoxesQuery(DateTime.Today, branchFilter));
            _availableBoxes = data.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar cajas disponibles");
            Snackbar.Add("Error al cargar cajas disponibles", Severity.Error);
        }
        finally
        {
            _isLoadingBoxes = false;
            StateHasChanged();
        }
    }

    private async Task OnCashRegisterChanged(int cashRegisterId)
    {
        _selectedCashRegisterId = cashRegisterId;
        _selectedCashierId = 0;
        _resolvedCashierName = null;

        if (cashRegisterId > 0 && _availableBoxes != null)
        {
            var selectedBox = _availableBoxes.FirstOrDefault(b => b.Id == cashRegisterId);
            if (selectedBox != null)
            {
                // Resolver el ID de sucursal de la caja
                int boxBranchId = _supervisorBranchId;
                if (boxBranchId <= 0 || _isAdmin)
                {
                    var register = await CashRegisterService.GetByIdAsync(cashRegisterId);
                    if (register != null && register.BranchId > 0)
                    {
                        boxBranchId = register.BranchId;
                    }
                }

                if (boxBranchId > 0)
                {
                    var cashier = await Mediator.Send(new GetCashierByContpaqIdQuery(boxBranchId, selectedBox.CashierId));
                    if (cashier != null)
                    {
                        _selectedCashierId = cashier.Id;
                        _resolvedCashierName = cashier.Name;
                    }
                    else
                    {
                        _selectedCashierId = 0;
                        _resolvedCashierName = $"ID Contpaqi: {selectedBox.CashierId} (No registrada)";
                    }
                }
            }
        }

        StateHasChanged();
    }

    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_supervisorName))
        {
            Snackbar.Add("❗No se identificó la encargada", Severity.Warning);
            return false;
        }

        if (_selectedCashRegisterId == 0)
        {
            _errorMessage = "Seleccione una caja";
            return false;
        }

        if (_selectedCashierId == 0)
        {
            _errorMessage = "No se pudo auto-resolver la cajera para este turno. Asegúrese de que la caja tenga una apertura vigente y la cajera esté registrada.";
            return false;
        }

        _total = (int)FinancialCalculator.CalculateDenominationsTotal(_c1000, _c500, _c200, _c100, _c50, _c20);

        if (_total <= 0)
        {
            _errorMessage = "El monto total debe ser mayor a cero";
            return false;
        }

        _errorMessage = string.Empty;
        return true;
    }

    private async Task ImprimirReco()
    {
        if (_isSubmitting) return;

        _isSubmitting = true;
        _errorMessage = string.Empty;
        _isError = false;
        try
        {
            if (!ValidateForm())
            {
                _isError = true;
                StateHasChanged();
                return;
            }

            var createDto = new CreateCashCollectionDto
            {
                Thousands = _c1000,
                FiveHundreds = _c500,
                TwoHundreds = _c200,
                Hundreds = _c100,
                Fifties = _c50,
                Twenties = _c20,
                CashRegisterName = _availableBoxes.FirstOrDefault(b => b.Id == _selectedCashRegisterId)?.Name ?? string.Empty,
                CashierName = _resolvedCashierName ?? string.Empty,
                SupervisorName = _supervisorName,
                IsForCashCut = false
            };

            var command = new CreateCashCollectionCommand(createDto, _selectedCashRegisterId);
            var result = await Mediator.Send(command);

            if (result.Success)
            {
                if (result.PrintingSucceeded)
                {
                    if (result.UsedBackupPrinter)
                    {
                        Snackbar.Add(result.Message, Severity.Warning);
                    }
                    else
                    {
                        Snackbar.Add("✅ Recolección impresa correctamente", Severity.Success);
                    }
                }
                else
                {
                    _isError = true;
                    _errorMessage = result.Message ?? "Error de impresión.";
                    Snackbar.Add(_errorMessage, Severity.Error);
                }

                ResetForm();
            }
            else
            {
                _errorMessage = $"Error al procesar la recolección: {result.Message}";
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al procesar la recolección: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        _selectedCashierId = 0;
        _selectedCashRegisterId = 0;
        _c1000 = 0;
        _c500 = 0;
        _c200 = 0;
        _c100 = 0;
        _c50 = 0;
        _c20 = 0;
        _total = 0;
        _resolvedCashierName = null;
    }

    private decimal CalculateTotal()
    {
        return FinancialCalculator.CalculateDenominationsTotal(_c1000, _c500, _c200, _c100, _c50, _c20);
    }

    private async Task ValidarNomina()
    {
        if (_employeeNumberInput <= 0)
        {
            _authErrorMessage = "Por favor ingrese un número de nómina válido";
            return;
        }

        _checkingSupervisor = true;
        _authErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var supervisor = await SupervisorService.GetByEmployeeNumberAsync(_employeeNumberInput);
            if (supervisor == null)
            {
                _authErrorMessage = "El número de nómina no coincide con ninguna encargada registrada";
            }
            else if (!supervisor.IsActive)
            {
                _authErrorMessage = "La encargada no se encuentra activa en el sistema";
            }
            else
            {
                // Authenticated successfully!
                _isSupervisorAuthenticated = true;
                _selectedSupervisor = supervisor;
                _supervisorBranchId = supervisor.BranchId;
                _supervisorName = supervisor.Name;
                
                var branches = await BranchService.GetAllAsync();
                _supervisorBranchName = branches.FirstOrDefault(b => b.Id == supervisor.BranchId)?.Name ?? "Desconocida";

                // Guardar en sessionStorage
                await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "supervisor_nomina", _employeeNumberInput.ToString());
                
                Snackbar.Add($"Bienvenida, {supervisor.Name}", Severity.Success);
                await CargarCajas();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al validar la nómina de la encargada");
            _authErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _checkingSupervisor = false;
            StateHasChanged();
        }
    }

    private async Task LogoutSupervisor()
    {
        _isSupervisorAuthenticated = false;
        _selectedSupervisor = null;
        _supervisorBranchId = 0;
        _supervisorName = string.Empty;
        _supervisorBranchName = string.Empty;
        _employeeNumberInput = 0;
        _availableBoxes.Clear();
        _selectedCashRegisterId = 0;
        _selectedCashierId = 0;
        _resolvedCashierName = null;
        
        await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "supervisor_nomina");
        Snackbar.Add("Sesión cerrada", Severity.Info);
        StateHasChanged();
    }
}

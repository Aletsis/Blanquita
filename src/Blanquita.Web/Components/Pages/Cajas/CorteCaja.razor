@page "/corte-caja"
@using Blanquita.Application.DTOs
@using Blanquita.Application.Interfaces
@using Blanquita.Application.Queries.Supervisors
@using Blanquita.Application.Queries.Cashiers
@using Blanquita.Application.Queries.Cajas
@using Blanquita.Application.Commands.Cajas
@using Blanquita.Application.Queries.Conciliaciones
@using Blanquita.Application.Helpers
@using MediatR
@using System.Globalization
@inject ISnackbar Snackbar
@inject IMediator Mediator
@inject ISupervisorService SupervisorService
@inject IBranchService BranchService
@inject IJSRuntime JSRuntime
@inject ILogger<RecoCaja> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Corte de Caja</PageTitle>
@if (!IsUserAuthorized)
{
    <!-- Pantalla de Autenticación Inline por Nómina -->
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center animate-fade-in" Style="min-height: 80vh;">
        <MudPaper Elevation="8" Class="pa-8 rounded-xl" Style="width: 100%; max-width: 450px;">
            <MudStack Spacing="4">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="width: 70px; height: 70px;">
                        <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold">Acceso de Encargada</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Ingrese su número de nómina para comenzar la conciliación
                    </MudText>
                </MudStack>

                <EditForm Model="this" OnValidSubmit="ValidarNomina">
                    <MudStack Spacing="3">
                        <MudNumericField @bind-Value="_employeeNumberInput"
                                         Label="Número de Nómina"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Required="true"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Numbers"
                                         HideSpinButtons="true" />

                        @if (!string.IsNullOrEmpty(_authErrorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="rounded-lg">@_authErrorMessage</MudAlert>
                        }

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Class="rounded-xl mt-2"
                                   Disabled="@_checkingSupervisor">
                            @if (_checkingSupervisor)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Validando...</MudText>
                            }
                            else
                            {
                                <MudText>Ingresar</MudText>
                            }
                        </MudButton>

                        <MudDivider Class="my-2" />

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Login"
                                   Href="/login?returnUrl=/conciliacion-corte"
                                   Class="rounded-xl">
                            Cambiar a login de usuario
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 animated fadeIn">
        <MudText Typo="Typo.h4" Class="mb-6 font-weight-bold" Style="background: linear-gradient(45deg, #d32f2f, #f44336); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Class="mr-2" Size="Size.Large" Color="Color.Error" />
            Corte de Caja
        </MudText>

        @if (_isSubmitting)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4 animate-fade-in" Elevation="2">
                <div class="d-flex align-center">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-3" />
                    <MudText Typo="Typo.body1">Procesando corte de caja...</MudText>
                </div>
            </MudAlert>
        }

        <EditForm Model="model" OnValidSubmit="HacerCorte">
            <MudGrid>
                <!-- Sección de Selección -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="4" Class="pa-4 rounded-lg animate-slide-up">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Color="Color.Primary">
                                    <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                                    Información del Personal
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudSelect T="int" 
                                    Label="Seleccione encargada" 
                                    Value="_selectedSupervisorId" 
                                    ValueChanged="@(async (int value) => await OnSupervisorChanged(value))"
                                    Variant="Variant.Outlined"
                                    AnchorOrigin="Origin.BottomCenter"
                                    Class="mb-4"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.SupervisorAccount">
                                @if (supervisors == null)
                                {
                                    <MudSelectItem T="int" Value="0">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        Cargando...
                                    </MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem T="int" Value="0">-- Seleccione una encargada --</MudSelectItem>
                                    @foreach (var supervisor in supervisors)
                                    {
                                        <MudSelectItem T="int" Value="@supervisor.Id">@supervisor.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                            <MudSelect T="int" 
                                    Label="Seleccione caja" 
                                    Value="_selectedCashRegisterId"
                                    ValueChanged="@(async (int value) => await OnCashRegisterChanged(value))"
                                    Variant="Variant.Outlined"
                                    AnchorOrigin="Origin.BottomCenter"
                                    Class="mb-4"
                                    Disabled="@(_selectedSupervisorId == 0)"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.PointOfSale">
                                @if (_availableBoxes == null || !_availableBoxes.Any())
                                {
                                    <MudSelectItem T="int" Value="0">
                                        @(_selectedSupervisorId == 0 ? "-- Seleccione una encargada primero --" : "-- No hay cajas con apertura disponibles --")
                                    </MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem T="int" Value="0">-- Seleccione una caja --</MudSelectItem>
                                    @foreach (var box in _availableBoxes)
                                    {
                                        <MudSelectItem T="int" Value="@box.Id">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Class="mr-2"/>
                                                @box.Name (Apertura: @box.Time.ToString("HH:mm"))
                                            </div>
                                        </MudSelectItem>
                                    }
                                }
                            </MudSelect>

                            @if (!string.IsNullOrEmpty(_resolvedCashierName))
                            {
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg border-light bg-light d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" Class="mr-2" />
                                    <MudText Typo="Typo.body1">Cajera asignada: <b>@_resolvedCashierName</b></MudText>
                                </MudPaper>
                            }
                            else if (_selectedSupervisorId > 0 && _selectedCashRegisterId > 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="rounded-lg">
                                    No se pudo auto-resolver la cajera para este turno.
                                </MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Sección de Totales -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="4" Class="pa-4 rounded-lg animate-slide-up" Style="animation-delay: 0.1s;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Color="Color.Error">
                                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
                                    Totales del Corte
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudNumericField @bind-Value="model.TotalSlips" 
                                        Label="Total de Tira (Efectivo)" 
                                        Variant="Variant.Outlined" 
                                        Min="0"
                                        Class="mb-4"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Filled.Receipt"
                                        AdornmentColor="Color.Info"
                                        Format="N2"
                                        Culture="@CultureInfo.InvariantCulture"
                                        HelperText="Total general mostrado en la tira de la caja registradora" />

                            <MudNumericField @bind-Value="model.TotalBanbajio" 
                                        Label="Total Banbajío" 
                                        Variant="Variant.Outlined" 
                                        Min="0"
                                        Class="mb-4"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Filled.CreditCard"
                                        AdornmentColor="Color.Warning"
                                        Format="N2"
                                        Culture="@CultureInfo.InvariantCulture"
                                        HelperText="Total de pagos con tarjeta Banbajío" />

                            <MudNumericField @bind-Value="model.TotalBanregio" 
                                        Label="Total Banregio" 
                                        Variant="Variant.Outlined" 
                                        Min="0"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Filled.CreditCard"
                                        AdornmentColor="Color.Secondary"
                                        Format="N2"
                                        Culture="@CultureInfo.InvariantCulture"
                                        HelperText="Total de pagos con tarjeta Banregio" />

                            <MudDivider Class="my-4" />

                            <div class="d-flex justify-center flex-column align-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Efectivo a Entregar</MudText>
                                <MudPaper Elevation="3" Class="pa-4 rounded-lg" Style="background: linear-gradient(135deg, #d32f2f 0%, #f44336 100%);">
                                    <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: white;">
                                        $ @CalculateCashToDeliver().ToString("N2", CultureInfo.InvariantCulture)
                                    </MudText>
                                </MudPaper>
                            </div>
                        </MudCardContent>
                        <MudCardActions Class="d-flex justify-center pa-4">
                            <MudButton ButtonType="ButtonType.Submit"
                                    Variant="Variant.Filled"
                                    Color="Color.Error"
                                    Disabled="@_isSubmitting"
                                    Size="Size.Large"
                                    StartIcon="@Icons.Material.Filled.ContentCut"
                                    FullWidth="true"
                                    Class="py-3 elevation-4">
                                @if (_isSubmitting)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <text>Procesando...</text>
                                }
                                else
                                {
                                    <text>Realizar Corte de Caja</text>
                                }
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudContainer>
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }
    .animate-slide-up {
        animation: slideUp 0.5s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    .rounded-lg {
        border-radius: 12px !important;
    }
</style>

@code {
    private bool _isUserAuthenticated;
    private bool _isSupervisorAuthenticated;
    private bool IsUserAuthorized => _isUserAuthenticated || _isSupervisorAuthenticated;
    private int _employeeNumberInput;
    private string _authErrorMessage = string.Empty;
    private bool _checkingSupervisor;
    private int _supervisorBranchId;
    private string _supervisorBranchName = string.Empty;
    private string _supervisorName = string.Empty;
    private bool _isAdmin;
    private CashCutViewModel model = new CashCutViewModel();
    private int _selectedCashRegisterId = 0;
    private List<AvailableBoxDto> _availableBoxes = new();
    private int _selectedSupervisorId = 0;
    private int _selectedCashierId = 0;
    private List<SupervisorDto>? supervisors;
    private string? _resolvedCashierName;
    private SupervisorDto? _selectedSupervisor;
    private bool _isSubmitting = false;
    private decimal _totalCollections = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAuthSession();
        }
    }

    private async Task CheckAuthSession()
    {
        try
        {
            // 1. Validar si está logueado como usuario estándar en el sistema
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                if (!user.IsInRole("Admin") && !user.IsInRole("Supervisor"))
                {
                    _authErrorMessage = "No tienes permisos para acceder a esta sección.";
                    StateHasChanged();
                    return; // Cae al formulario de nómina
                }
                _isUserAuthenticated = true;
                _isAdmin = user.IsInRole("Admin");
                StateHasChanged();
                return;
            }

            // 2. Si no, validar si está logueado temporalmente por número de nómina en sessionStorage
            var storedNominaStr = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "supervisor_nomina");
            if (int.TryParse(storedNominaStr, out int storedNomina))
            {
                var supervisor = await SupervisorService.GetByEmployeeNumberAsync(storedNomina);
                if (supervisor != null && supervisor.IsActive)
                {
                    _isSupervisorAuthenticated = true;
                    _supervisorBranchId = supervisor.BranchId;
                    _supervisorName = supervisor.Name;
                    
                    var branches = await BranchService.GetAllAsync();
                    _supervisorBranchName = branches.FirstOrDefault(b => b.Id == supervisor.BranchId)?.Name ?? "Desconocida";
                    
                    StateHasChanged();
                    return;
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al comprobar sesión de autenticación");
        }
    }
    protected override async Task OnInitializedAsync()
    {
        var result = await Mediator.Send(new GetSupervisorsQuery());
        supervisors = result.ToList();
    }

    private async Task OnSupervisorChanged(int supervisorId)
    {
        _selectedSupervisorId = supervisorId;
        _selectedCashierId = 0; 
        _selectedCashRegisterId = 0;
        _totalCollections = 0;
        _resolvedCashierName = null;
        _availableBoxes = new List<AvailableBoxDto>();

        if (supervisorId > 0 && supervisors != null)
        {
            _selectedSupervisor = supervisors.FirstOrDefault(s => s.Id == supervisorId);
            if (_selectedSupervisor != null)
            {
                var data = await Mediator.Send(new GetAvailableBoxesQuery(DateTime.Today, _selectedSupervisor.BranchId));
                _availableBoxes = data.ToList();
            }
        }

        StateHasChanged();
    }

    private async Task OnCashRegisterChanged(int cashRegisterId)
    {
        _selectedCashRegisterId = cashRegisterId;
        _totalCollections = 0;
        _selectedCashierId = 0;
        _resolvedCashierName = null;

        if (cashRegisterId > 0 && _availableBoxes != null)
        {
            var selectedBox = _availableBoxes.FirstOrDefault(b => b.Id == cashRegisterId);
            if (selectedBox != null)
            {
                // Obtener recolecciones sin corte de esta caja
                await LoadCollectionsTotal(selectedBox.Name);

                // Obtener cajera automática según el CashierId del turno
                if (_selectedSupervisor != null)
                {
                    var cashier = await Mediator.Send(new GetCashierByContpaqIdQuery(_selectedSupervisor.BranchId, selectedBox.CashierId));
                    if (cashier != null)
                    {
                        _selectedCashierId = cashier.Id;
                        _resolvedCashierName = cashier.Name;
                    }
                    else
                    {
                        _selectedCashierId = 0;
                        _resolvedCashierName = $"ID Contpaqi: {selectedBox.CashierId} (No registrada)";
                    }
                }
            }
        }

        StateHasChanged();
    }

    private async Task LoadCollectionsTotal(string cashRegisterName)
    {
        try
        {
            _totalCollections = await Mediator.Send(new GetCollectionsTotalQuery(cashRegisterName, DateTime.Today));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar recolecciones: {ex.Message}", Severity.Warning);
            _totalCollections = 0;
        }
    }

    private async Task HacerCorte()
    {
        if (_isSubmitting) return;
        if (_selectedSupervisorId == 0 || _selectedCashierId == 0 || _selectedCashRegisterId == 0)
        {
            Snackbar.Add("❗ Debe seleccionar encargada, cajera y caja.", Severity.Warning);
            return;
        }
        _isSubmitting = true;
        try
        {
            var request = new ProcessCashCutRequest
            {
                SupervisorId = _selectedSupervisorId,
                CashierId = _selectedCashierId,
                CashRegisterId = _selectedCashRegisterId,
                TotalSlips = model.TotalSlips,
                TotalBanbajio = model.TotalBanbajio,
                TotalBanregio = model.TotalBanregio
            };

            var command = new ProcessCashCutCommand(request);
            var result = await Mediator.Send(command);

            if (result.Success)
            {
                if (result.PrintingSucceeded)
                {
                    Snackbar.Add("✅ Corte impreso correctamente", Severity.Success);
                }
                else
                {
                    Snackbar.Add($"⚠️ Corte guardado, pero {result.Message}", Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add($"❌ Error al realizar el corte: {result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Error general al realizar el corte: {ex.Message}", Severity.Error);
        }
        finally
        {
            ResetForm();
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _selectedSupervisorId = 0;
        _selectedCashierId = 0;
        _selectedCashRegisterId = 0;
        _totalCollections = 0;
        _resolvedCashierName = null;
        _availableBoxes = new List<AvailableBoxDto>();
        model = new CashCutViewModel();
    }

    private decimal CalculateCashToDeliver()
    {
        return FinancialCalculator.CalculateCashToDeliver(model.TotalSlips, model.TotalBanbajio, model.TotalBanregio, _totalCollections);
    }
    private async Task ValidarNomina()
    {
        if (_employeeNumberInput <= 0)
        {
            _authErrorMessage = "Por favor ingrese un número de nómina válido";
            return;
        }

        _checkingSupervisor = true;
        _authErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var supervisor = await SupervisorService.GetByEmployeeNumberAsync(_employeeNumberInput);
            if (supervisor == null)
            {
                _authErrorMessage = "El número de nómina no coincide con ninguna encargada registrada";
            }
            else if (!supervisor.IsActive)
            {
                _authErrorMessage = "La encargada no se encuentra activa en el sistema";
            }
            else
            {
                // Authenticated successfully!
                _isSupervisorAuthenticated = true;
                _supervisorBranchId = supervisor.BranchId;
                _supervisorName = supervisor.Name;
                
                var branches = await BranchService.GetAllAsync();
                _supervisorBranchName = branches.FirstOrDefault(b => b.Id == supervisor.BranchId)?.Name ?? "Desconocida";

                // Guardar en sessionStorage
                await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "supervisor_nomina", _employeeNumberInput.ToString());
                
                Snackbar.Add($"Bienvenida, {supervisor.Name}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al validar la nómina de la encargada");
            _authErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _checkingSupervisor = false;
            StateHasChanged();
        }
    }

    public class CashCutViewModel
    {
        public decimal TotalSlips { get; set; }
        public decimal TotalBanbajio { get; set; }
        public decimal TotalBanregio { get; set; }
    }
}
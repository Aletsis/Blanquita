@page "/corte-caja"
@using Blanquita.Application.DTOs
@using Blanquita.Application.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Blanquita.Application.Queries.Supervisors
@using Blanquita.Application.Queries.Cashiers
@using Blanquita.Application.Queries.Cajas
@using Blanquita.Application.Commands.Cajas
@using Blanquita.Application.Queries.Conciliaciones
@using Blanquita.Application.Helpers
@using MediatR
@using System.Globalization
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject ISnackbar Snackbar
@inject IMediator Mediator
@inject ISupervisorService SupervisorService
@inject IBranchService BranchService
@inject IUserService UserService
@inject ICashRegisterService CashRegisterService
@inject IJSRuntime JSRuntime
@inject ILogger<CorteCaja> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Corte de Caja</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 animated fadeIn">
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-6">
        <MudText Typo="Typo.h4" Class="font-weight-bold mb-2 mb-sm-0" Style="background: linear-gradient(45deg, #d32f2f, #f44336); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Class="mr-2" Size="Size.Large" Color="Color.Error" />
            Corte de Caja
        </MudText>

        <div class="d-flex align-center">
            <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.Store" Class="mr-2">
                Sucursal: @(_isAdmin && _supervisorBranchId <= 0 ? "Todas las sucursales" : _supervisorBranchName)
            </MudChip>
            <MudChip T="string" Color="@(_isAdmin ? Color.Success : Color.Primary)" Variant="Variant.Filled" Icon="@(_isAdmin ? Icons.Material.Filled.AdminPanelSettings : Icons.Material.Filled.Person)">
                @_supervisorName
            </MudChip>
        </div>
    </div>

        @if (_isSubmitting)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4 animate-fade-in" Elevation="2">
                <div class="d-flex align-center">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-3" />
                    <MudText Typo="Typo.body1">Procesando corte de caja...</MudText>
                </div>
            </MudAlert>
        }

        <EditForm Model="model" OnValidSubmit="HacerCorte">
            <MudGrid>
                <!-- Sección de Selección -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="4" Class="pa-4 rounded-lg animate-slide-up">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Color="Color.Primary">
                                    <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                                    Información del Personal
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudPaper Elevation="0" Class="pa-3 rounded-lg border-light bg-light d-flex align-center mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Usuario / Responsable</MudText>
                                    <MudText Typo="Typo.body1" Class="font-weight-bold">@_supervisorName</MudText>
                                    @if (!string.IsNullOrEmpty(_supervisorBranchName) && !_isAdmin)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Info">Sucursal: @_supervisorBranchName</MudText>
                                    }
                                    else if (_isAdmin)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success">Todas las sucursales (Administrador)</MudText>
                                    }
                                </div>
                            </MudPaper>

                            <MudSelect T="int" 
                                    Label="Seleccione caja" 
                                    Value="_selectedCashRegisterId" 
                                    ValueChanged="@(async (int value) => await OnCashRegisterChanged(value))"
                                    Variant="Variant.Outlined"
                                    AnchorOrigin="Origin.BottomCenter"
                                    Class="mb-4"
                                    Disabled="@_isSubmitting"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.PointOfSale">
                                @if (_isLoadingBoxes)
                                {
                                    <MudSelectItem T="int" Value="0">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        Cargando cajas disponibles...
                                    </MudSelectItem>
                                }
                                else if (_availableBoxes == null || !_availableBoxes.Any())
                                {
                                    <MudSelectItem T="int" Value="0">
                                        -- No hay cajas con apertura disponibles --
                                    </MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem T="int" Value="0">-- Seleccione una caja --</MudSelectItem>
                                    @foreach (var box in _availableBoxes)
                                    {
                                        <MudSelectItem T="int" Value="@box.Id">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Class="mr-2"/>
                                                @box.Name (Apertura: @box.Time.ToString("HH:mm"))
                                            </div>
                                        </MudSelectItem>
                                    }
                                }
                            </MudSelect>

                            @if (!string.IsNullOrEmpty(_resolvedCashierName))
                            {
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg border-light bg-light d-flex align-center mb-4">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" Class="mr-2" />
                                    <MudText Typo="Typo.body1">Cajera asignada: <b>@_resolvedCashierName</b></MudText>
                                </MudPaper>
                            }
                            else if (_selectedCashRegisterId > 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="rounded-lg">
                                    No se pudo auto-resolver la cajera para este turno.
                                </MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Sección de Totales -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="4" Class="pa-4 rounded-lg animate-slide-up" Style="animation-delay: 0.1s;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Color="Color.Error">
                                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
                                    Totales del Corte
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudNumericField @bind-Value="model.TotalSlips" 
                                        Label="Total de Tira (Efectivo)" 
                                        Variant="Variant.Outlined" 
                                        Min="0"
                                        Class="mb-4"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Filled.Receipt"
                                        AdornmentColor="Color.Info"
                                        Format="N2"
                                        Culture="@CultureInfo.InvariantCulture"
                                        HelperText="Total general mostrado en la tira de la caja registradora" />

                            <MudNumericField @bind-Value="model.TotalBanbajio" 
                                        Label="Total Banbajío" 
                                        Variant="Variant.Outlined" 
                                        Min="0"
                                        Class="mb-4"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Filled.CreditCard"
                                        AdornmentColor="Color.Warning"
                                        Format="N2"
                                        Culture="@CultureInfo.InvariantCulture"
                                        HelperText="Total de pagos con tarjeta Banbajío" />

                            <MudNumericField @bind-Value="model.TotalBanregio" 
                                        Label="Total Banregio" 
                                        Variant="Variant.Outlined" 
                                        Min="0"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Filled.CreditCard"
                                        AdornmentColor="Color.Secondary"
                                        Format="N2"
                                        Culture="@CultureInfo.InvariantCulture"
                                        HelperText="Total de pagos con tarjeta Banregio" />

                            <MudDivider Class="my-4" />

                            <div class="d-flex justify-center flex-column align-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Efectivo a Entregar</MudText>
                                <MudPaper Elevation="3" Class="pa-4 rounded-lg" Style="background: linear-gradient(135deg, #d32f2f 0%, #f44336 100%);">
                                    <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: white;">
                                        $ @CalculateCashToDeliver().ToString("N2", CultureInfo.InvariantCulture)
                                    </MudText>
                                </MudPaper>
                            </div>
                        </MudCardContent>
                        <MudCardActions Class="d-flex justify-center pa-4">
                            <MudButton ButtonType="ButtonType.Submit"
                                    Variant="Variant.Filled"
                                    Color="Color.Error"
                                    Disabled="@_isSubmitting"
                                    Size="Size.Large"
                                    StartIcon="@Icons.Material.Filled.ContentCut"
                                    FullWidth="true"
                                    Class="py-3 elevation-4">
                                @if (_isSubmitting)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <text>Procesando...</text>
                                }
                                else
                                {
                                    <text>Realizar Corte de Caja</text>
                                }
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudContainer>

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }
    .animate-slide-up {
        animation: slideUp 0.5s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    .rounded-lg {
        border-radius: 12px !important;
    }
</style>

@code {
    private int _supervisorBranchId;
    private string _supervisorBranchName = string.Empty;
    private string _supervisorName = string.Empty;
    private bool _isAdmin;
    private CashCutViewModel model = new CashCutViewModel();
    private int _selectedCashRegisterId = 0;
    private List<AvailableBoxDto> _availableBoxes = new();
    private int _selectedCashierId = 0;
    private string? _resolvedCashierName;
    private bool _isSubmitting = false;
    private decimal _totalCollections = 0;
    private bool _isLoadingBoxes = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserSessionAsync();
    }

    private async Task LoadUserSessionAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole("Admin");
            
            var fullNameClaim = user.FindFirst("FullName")?.Value;
            var branchIdClaim = user.FindFirst("BranchId")?.Value;
            var username = user.Identity?.Name ?? string.Empty;

            _supervisorName = !string.IsNullOrWhiteSpace(fullNameClaim) ? fullNameClaim : username;

            if (int.TryParse(branchIdClaim, out int branchId) && branchId > 0)
            {
                _supervisorBranchId = branchId;
                var branch = await BranchService.GetByIdAsync(branchId);
                _supervisorBranchName = branch?.Name ?? "Desconocida";
            }
            else
            {
                _supervisorBranchId = 0;
                _supervisorBranchName = _isAdmin ? "Todas las sucursales" : string.Empty;
            }

            await CargarCajas();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar sesión de usuario en Corte de Caja");
            Snackbar.Add("Error al cargar la información del usuario", Severity.Error);
        }
    }

    private async Task CargarCajas()
    {
        _isLoadingBoxes = true;
        StateHasChanged();
        try
        {
            int? branchFilter = _isAdmin ? (_supervisorBranchId > 0 ? _supervisorBranchId : (int?)null) : (_supervisorBranchId > 0 ? _supervisorBranchId : (int?)null);
            var data = await Mediator.Send(new GetAvailableBoxesQuery(DateTime.Today, branchFilter));
            _availableBoxes = data.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar cajas disponibles");
            Snackbar.Add("Error al cargar cajas disponibles", Severity.Error);
        }
        finally
        {
            _isLoadingBoxes = false;
            StateHasChanged();
        }
    }

    private async Task OnCashRegisterChanged(int cashRegisterId)
    {
        _selectedCashRegisterId = cashRegisterId;
        _totalCollections = 0;
        _selectedCashierId = 0;
        _resolvedCashierName = null;

        if (cashRegisterId > 0 && _availableBoxes != null)
        {
            var selectedBox = _availableBoxes.FirstOrDefault(b => b.Id == cashRegisterId);
            if (selectedBox != null)
            {
                await LoadCollectionsTotal(selectedBox.Name);

                int boxBranchId = _supervisorBranchId;
                if (boxBranchId <= 0 || _isAdmin)
                {
                    var register = await CashRegisterService.GetByIdAsync(cashRegisterId);
                    if (register != null && register.BranchId > 0)
                    {
                        boxBranchId = register.BranchId;
                    }
                }

                if (boxBranchId > 0)
                {
                    var cashier = await Mediator.Send(new GetCashierByContpaqIdQuery(boxBranchId, selectedBox.CashierId));
                    if (cashier != null)
                    {
                        _selectedCashierId = cashier.Id;
                        _resolvedCashierName = cashier.Name;
                    }
                    else
                    {
                        _selectedCashierId = 0;
                        _resolvedCashierName = $"ID Contpaqi: {selectedBox.CashierId} (No registrada)";
                    }
                }
            }
        }

        StateHasChanged();
    }

    private async Task LoadCollectionsTotal(string cashRegisterName)
    {
        try
        {
            _totalCollections = await Mediator.Send(new GetCollectionsTotalQuery(cashRegisterName, DateTime.Today));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar recolecciones: {ex.Message}", Severity.Warning);
            _totalCollections = 0;
        }
    }

    private async Task HacerCorte()
    {
        if (_isSubmitting) return;
        if (_selectedCashRegisterId == 0)
        {
            Snackbar.Add("❗ Debe seleccionar una caja registradora.", Severity.Warning);
            return;
        }
        if (_selectedCashierId == 0)
        {
            Snackbar.Add("❗ No se pudo auto-resolver la cajera para este turno.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_supervisorName))
        {
            Snackbar.Add("❗ No se identificó el usuario responsable.", Severity.Warning);
            return;
        }
        _isSubmitting = true;
        try
        {
            var request = new ProcessCashCutRequest
            {
                SupervisorId = 0,
                SupervisorName = _supervisorName,
                BranchId = _supervisorBranchId,
                CashierId = _selectedCashierId,
                CashRegisterId = _selectedCashRegisterId,
                TotalSlips = model.TotalSlips,
                TotalBanbajio = model.TotalBanbajio,
                TotalBanregio = model.TotalBanregio
            };

            var command = new ProcessCashCutCommand(request);
            var result = await Mediator.Send(command);

            if (result.Success)
            {
                if (result.PrintingSucceeded)
                {
                    Snackbar.Add("✅ Corte impreso correctamente", Severity.Success);
                }
                else
                {
                    Snackbar.Add($"⚠️ Corte guardado, pero {result.Message}", Severity.Warning);
                }
                ResetForm();
                await CargarCajas();
            }
            else
            {
                Snackbar.Add($"❌ Error al realizar el corte: {result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Error general al realizar el corte: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        _selectedCashRegisterId = 0;
        _selectedCashierId = 0;
        _totalCollections = 0;
        _resolvedCashierName = null;
        model = new CashCutViewModel();
    }

    private decimal CalculateCashToDeliver()
    {
        return FinancialCalculator.CalculateCashToDeliver(model.TotalSlips, model.TotalBanbajio, model.TotalBanregio, _totalCollections);
    }

    public class CashCutViewModel
    {
        public decimal TotalSlips { get; set; }
        public decimal TotalBanbajio { get; set; }
        public decimal TotalBanregio { get; set; }
    }
}
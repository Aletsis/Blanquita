@inject IFoxProPedidoRepository PedidoRepository
@inject IClientCatalogRepository ClientRepository
@using Blanquita.Application.Interfaces.Repositories
@using Blanquita.Application.DTOs

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Detalle de Pedido: @Pedido.Folio</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-height: 650px; overflow-y: auto" Class="pa-0">
            <MudGrid Spacing="2">
                <!-- Información General (Cabecera POS10008) -->
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-4 rounded-lg border-dashed border-2">
                        Esta es una vista previa de la información de la Nota de venta @Pedido.Folio.
                    </MudAlert>
                    
                    <MudPaper Elevation="0" Class="pa-5 rounded-xl bg-light-gradient border-light mb-4">
                        <MudGrid>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Fecha de Nota</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@Pedido.Fecha.ToString("dd/MM/yyyy")</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Sucursal</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@Pedido.BranchName</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">No. Comanda</MudText>
                                <div>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Class="ma-0">@Pedido.Comanda</MudChip>
                                </div>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Estado Actual</MudText>
                                <div>
                                    @{
                                        var color = Pedido.Status == "Cobrada" ? Color.Success : 
                                                   (Pedido.Status == "Impresa" ? Color.Info : 
                                                   (Pedido.Status == "Pendiente" ? Color.Warning : Color.Error));
                                                   
                                        var icon = Pedido.Status == "Cobrada" ? Icons.Material.Filled.Payments : 
                                                  (Pedido.Status == "Impresa" ? Icons.Material.Filled.Print : 
                                                  (Pedido.Status == "Pendiente" ? Icons.Material.Filled.AccessTime : 
                                                  (Pedido.Status == "Cancelado" ? Icons.Material.Filled.Cancel : Icons.Material.Filled.KeyboardReturn)));
                                    }
                                    <MudChip T="string" Size="Size.Small" 
                                             Color="@color" 
                                             Icon="@icon"
                                             Variant="Variant.Filled" Class="ma-0">@Pedido.Status</MudChip>
                                </div>
                            </MudItem>
                            
                            <MudItem xs="12" md="8">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Cliente / Razón Social</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-bold mb-1">@Pedido.Cliente</MudText>
                                
                                @if (Address != null)
                                {
                                    <div class="mt-2 pa-3 rounded-lg bg-surface border border-light" style="background-color: rgba(255,255,255,0.55); border: 1px solid rgba(0,0,0,0.08) !important;">
                                        <div class="d-flex align-start">
                                            <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Primary" Size="Size.Small" Class="mr-2 mt-1" />
                                            <div>
                                                <MudText Typo="Typo.caption" Class="font-weight-bold" Color="Color.Primary">Dirección de Entrega</MudText>
                                                <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">
                                                    @Address.Street @(string.IsNullOrEmpty(Address.ExteriorNumber) ? "" : $"#{Address.ExteriorNumber}") @(string.IsNullOrEmpty(Address.InteriorNumber) ? "" : $"Int. {Address.InteriorNumber}")
                                                </MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    Col. @Address.Colony, C.P. @Address.ZipCode
                                                </MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    @Address.City, @Address.State
                                                </MudText>
                                                
                                                @if (!string.IsNullOrEmpty(Address.Phone))
                                                {
                                                    <div class="d-flex align-center mt-1">
                                                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Tel: @Address.Phone</MudText>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (_loading)
                                {
                                    <MudSkeleton Width="100%" Height="60px" Class="mt-2 rounded-lg" />
                                }
                                else
                                {
                                    <div class="mt-2 d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOff" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Sin dirección registrada en BD.</MudText>
                                    </div>
                                }
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <div class="d-flex flex-column align-end">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Importe Total</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@Pedido.Total.ToString("C2")</MudText>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                <!-- Listado de Artículos (Detalles POS10010) -->
                <MudItem xs="12">
                    <div class="d-flex align-center mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Color="Color.Primary" Class="mr-2" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Partidas de la Nota (POS10010)</MudText>
                    </div>
                    
                    <MudTable Items="_detalles" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-xl overflow-hidden border-light" Striped="true" Loading="@_loading">
                        <HeaderContent>
                            <MudTh Class="bg-surface">Cód. Artículo</MudTh>
                            <MudTh Class="bg-surface">Descripción</MudTh>
                            <MudTh Class="bg-surface" Style="text-align: center;">Cantidad</MudTh>
                            <MudTh Class="bg-surface" Style="text-align: right;">P. Unitario</MudTh>
                            <MudTh Class="bg-surface" Style="text-align: right;">Subtotal</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Cód. Artículo">
                                <MudText Typo="Typo.body2" Class="font-mono">@context.Codigo</MudText>
                            </MudTd>
                            <MudTd DataLabel="Descripción">@context.Descripcion</MudTd>
                            <MudTd DataLabel="Cantidad" Style="text-align: center;">
                                <MudText Typo="Typo.body2">@context.Cantidad.ToString("N2")</MudText>
                            </MudTd>
                            <MudTd DataLabel="P. Unitario" Style="text-align: right;">@context.Precio.ToString("C2")</MudTd>
                            <MudTd DataLabel="Subtotal" Style="text-align: right;">
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Subtotal.ToString("C2")</MudText>
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTFootRow Class="bg-light">
                                <MudTd colspan="4" Style="text-align: right;">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">SUBTOTAL:</MudText>
                                </MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@Pedido.NetAmount.ToString("C2")</MudText>
                                </MudTd>
                            </MudTFootRow>
                            <MudTFootRow Class="bg-light">
                                <MudTd colspan="4" Style="text-align: right;">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">IVA:</MudText>
                                </MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@Pedido.TaxAmount.ToString("C2")</MudText>
                                </MudTd>
                            </MudTFootRow>
                            <MudTFootRow Style="background-color: var(--mud-palette-primary-hover)">
                                <MudTd colspan="4" Style="text-align: right;">
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Color="Color.Primary">TOTAL NOTA:</MudText>
                                </MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Color="Color.Primary">@Pedido.Total.ToString("C2")</MudText>
                                </MudTd>
                            </MudTFootRow>
                        </FooterContent>
                    </MudTable>
                </MudItem>
                
                <MudItem xs="12" Class="mt-2">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg border-dashed">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Esta nota fue procesada por el sistema de punto de venta y se encuentra sincronizada con la base de datos central.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <div class="d-flex justify-space-between w-100 pa-2">
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" OnClick="Cerrar" Color="Color.Default" Class="rounded-pill px-6">Cerrar</MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" OnClick="Imprimir" Class="rounded-pill px-6">Reimprimir Ticket</MudButton>
            </MudStack>
        </div>
    </DialogActions>
</MudDialog>

<style>
    .bg-light-gradient { background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); }
    .border-light { border: 1px solid rgba(0,0,0,0.05) !important; }
    .font-weight-bold { font-weight: 700; }
    .font-mono { font-family: 'Cascadia Code', 'Consolas', monospace; }
    .rounded-xl { border-radius: 20px !important; }
    .bg-light { background-color: rgba(0,0,0,0.02); }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    
    [Parameter] public PedidoDto Pedido { get; set; } = new();

    private List<PedidoItemDto> _detalles = new();
    private ClientSearchDto? _clientDetails;
    private ClientAddressDto? Address => _clientDetails?.Addresses.FirstOrDefault();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            
            // Ejecutar consultas en paralelo para mejorar el tiempo de carga
            var itemsTask = PedidoRepository.GetPedidoItemsAsync(Pedido.IdDocumento);
            
            Task<ClientSearchDto?> clientTask = Task.FromResult<ClientSearchDto?>(null);
            if (Pedido.ClienteId > 0)
            {
                clientTask = ClientRepository.GetByIdAsync(Pedido.ClienteId);
            }

            await Task.WhenAll(itemsTask, clientTask);

            _detalles = (await itemsTask).ToList();
            _clientDetails = await clientTask;
        }
        catch (Exception ex)
        {
            // Error handling
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cerrar() => MudDialog.Cancel();
    
    private void Imprimir() 
    {
        // Funcionalidad dummy
    }
}

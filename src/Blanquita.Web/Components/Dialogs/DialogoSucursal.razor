@using Blanquita.Application.DTOs
@using Blanquita.Application.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject ISnackbar Snackbar
@inject IBranchService BranchService
@inject ICommercialApiService CommercialApiService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<DialogoSucursal> Logger

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="@Model" @bind-IsValid="@success">
            <MudTextField @bind-Value="Model.Name" 
                          Label="Nombre de sucursal" 
                          Required="true" 
                          RequiredError="El nombre es obligatorio" 
                          Variant="Variant.Outlined" 
                          Class="mb-3" />

            <MudTextField @bind-Value="Model.Code" 
                          Label="Código" 
                          Required="true" 
                          RequiredError="El código es obligatorio" 
                          Variant="Variant.Outlined" 
                          Class="mb-3" />
            
            <MudTextField @bind-Value="Model.SeriesCliente" 
                          Label="Serie Clientes" 
                          Variant="Variant.Outlined" 
                          Class="mb-3" 
                          HelperText="Serie para facturas de clientes (ej. A, B)" />
                          
            <MudTextField @bind-Value="Model.SeriesGlobal" 
                          Label="Serie Global" 
                          Variant="Variant.Outlined" 
                          Class="mb-3" 
                          HelperText="Serie para facturas de venta global" />
                          
            <MudTextField @bind-Value="Model.SeriesDevolucion" 
                           Label="Serie Devolución" 
                           Variant="Variant.Outlined" 
                           Class="mb-3" 
                           HelperText="Serie para notas de devolución" />

            <MudTextField @bind-Value="Model.Direccion" 
                           Label="Dirección" 
                           Variant="Variant.Outlined" 
                           Class="mb-3" 
                           Lines="2"
                           HelperText="Dirección física de la sucursal" />

            @if (_cargandoConceptos)
            {
                <div class="d-flex align-center justify-center pa-4 mb-3 border rounded-lg">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <MudText Typo="Typo.body2" Class="text-muted">Cargando conceptos de salida...</MudText>
                </div>
            }
            else if (_conceptos != null && _conceptos.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1 font-weight-bold">Conceptos de Salida autorizados:</MudText>
                <div style="max-height: 150px; overflow-y: auto; border: 1px solid rgba(0,0,0,0.12); padding: 8px; border-radius: 8px;" class="mb-3">
                    @foreach (var concepto in _conceptos)
                    {
                        <MudCheckBox T="bool" 
                                     Value="@IsConceptSelected(concepto.CCODIGOCONCEPTO)" 
                                     ValueChanged="@((bool val) => OnConceptSelectionChanged(concepto.CCODIGOCONCEPTO, val))" 
                                     Label="@($"{concepto.CCODIGOCONCEPTO} - {concepto.CNOMBRECONCEPTO}")" 
                                     Color="Color.Primary" 
                                     Dense="true" 
                                     Class="my-1" />
                    }
                </div>
            }
            else
            {
                <MudTextField @bind-Value="Model.ConceptosSalida" 
                              Label="Conceptos de Salida (Separados por comas)" 
                              Variant="Variant.Outlined" 
                              Class="mb-3" 
                              HelperText="No se pudieron cargar conceptos. Ingrese códigos de salida manualmente (ej. 101,102)" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Cancelar</MudButton>
        <MudButton Color="Color.Primary" 
                   OnClick="Submit" 
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .text-muted {
        color: #64748b !important;
    }
    .rounded-lg {
        border-radius: 8px !important;
    }
    .border {
        border: 1px solid rgba(0, 0, 0, 0.12) !important;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public BranchDto Model { get; set; } = new();

    private MudForm form = null!;
    private bool success;

    private bool _cargandoConceptos = true;
    private IEnumerable<CommercialConceptoDto>? _conceptos;
    private List<string> _selectedConcepts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _cargandoConceptos = true;

            // Inicializar la lista de conceptos previamente seleccionados
            if (!string.IsNullOrEmpty(Model.ConceptosSalida))
            {
                _selectedConcepts = Model.ConceptosSalida.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? string.Empty;

            if (!string.IsNullOrEmpty(username))
            {
                // Tipo de documento 33 = Salidas de Almacén en CONTPAQi
                _conceptos = await CommercialApiService.GetConceptosAsync(33, username);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar conceptos en el diálogo de sucursal");
            Snackbar.Add("No se pudieron conectar los conceptos de la API Comercial.", Severity.Warning);
        }
        finally
        {
            _cargandoConceptos = false;
        }
    }

    private bool IsConceptSelected(string codigo) => _selectedConcepts.Contains(codigo);

    private void OnConceptSelectionChanged(string codigo, bool val)
    {
        if (val)
        {
            if (!_selectedConcepts.Contains(codigo))
            {
                _selectedConcepts.Add(codigo);
            }
        }
        else
        {
            _selectedConcepts.Remove(codigo);
        }
        Model.ConceptosSalida = string.Join(",", _selectedConcepts);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(Model));
        }
    }
}

# Copie este archivo como .env en la carpeta del servicio (junto a package.json).
PORT=3001
NODE_ENV=production
# Obligatoria: sin ella el servicio rechaza todas las peticiones. Debe coincidir con la API Key en Configuración > WhatsApp.
WHATSAPP_API_KEY=CAMBIAR_POR_UNA_LLAVE_ALEATORIA
# Tamaño máximo del cuerpo JSON (documentos en Base64)
WHATSAPP_JSON_LIMIT=25mb

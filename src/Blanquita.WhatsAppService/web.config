<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Indica que index.cjs es la aplicación puente de Node.js -->
    <handlers>
      <add name="iisnode" path="index.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Redirigir todas las solicitudes a la aplicación Node.js; los archivos físicos solo se sirven
             si no están ocultos abajo (hiddenSegments) -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="index.cjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- Sin errores detallados ni depurador expuestos: los mensajes de error pueden incluir rutas y datos internos.
         Los logs de iisnode se siguen escribiendo en la carpeta iisnode (oculta abajo). -->
    <iisnode
      loggingEnabled="true"
      devErrorsEnabled="false"
      debuggingEnabled="false"
      nodeProcessCommandLine="node.exe --experimental-modules"
      watchedFiles="web.config;*.js"
    />

    <security>
      <requestFiltering>
        <!-- La raíz del sitio es la carpeta del servicio: sin esto IIS serviría como archivos estáticos
             la sesión de WhatsApp (auth_info/creds.json), el .env con la API key y los logs de iisnode -->
        <hiddenSegments>
          <remove segment="bin"/>
          <add segment="node_modules" />
          <add segment="auth_info" />
          <add segment=".env" />
          <add segment="iisnode" />
          <add segment="src" />
          <add segment="dist" />
          <add segment="package.json" />
          <add segment="package-lock.json" />
          <add segment="tsconfig.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <directoryBrowse enabled="false" />

    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
